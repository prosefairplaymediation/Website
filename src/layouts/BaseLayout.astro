---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import MusicPlayer from "../components/MusicPlayer.astro";
import ChatWidget from "../components/ChatWidget.astro";
import StickyCta from "../components/StickyCta.astro";
import { BING_SITE_VERIFICATION } from "../consts.ts";
import { OPENING_HOURS } from "../consts.ts";
import { getReviewData } from "../lib/reviews.ts";
import {
  ATTRIBUTION_KEY,
  ATTRIBUTION_TTL_DAYS,
  AW_CONVERSION_ID,
} from "../lib/attribution.ts";

/**
 * The parts of the business schema that come from data rather than from a
 * literal, emitted as a second JSON-LD block carrying the same `@id` as the
 * main one. Nodes sharing an `@id` are merged, so this adds to that entity
 * rather than describing a second business — which is also why the two can
 * live apart without the 120-line literal above having to become a template.
 *
 * Nothing here is emitted unless there is something true to say.
 */
const reviewData = await getReviewData();

const openingHoursSpecification = OPENING_HOURS.map((slot) => ({
  "@type": "OpeningHoursSpecification",
  dayOfWeek: slot.days,
  opens: slot.opens,
  closes: slot.closes,
}));

/**
 * The rating shown on the site, declared so a machine can read it.
 *
 * Worth knowing before expecting stars in search results: Google restricts
 * review snippets for a business's own page, and ratings gathered on a
 * third-party site — which is what these are, since they are Google's own
 * reviews via Featurable — are generally not eligible. The usual outcome of
 * this markup is therefore "no stars", not a penalty. It is here because the
 * declaration is honest and costs nothing; the stars in local results come
 * from the Google Business Profile itself, which is where that effort belongs.
 *
 * Only emitted when there are real reviews behind it. Never a hard-coded 5.0.
 */
const rated = reviewData.reviews.filter((r) => typeof r.stars === "number");
const aggregateRating =
  reviewData.average && rated.length > 0
    ? {
        "@type": "AggregateRating",
        ratingValue: reviewData.average,
        reviewCount: rated.length,
        bestRating: "5",
        worstRating: "1",
      }
    : null;

const businessExtras = {
  "@context": "https://schema.org",
  "@id": "https://prosefairplaymediation.com/#business",
  ...(openingHoursSpecification.length && { openingHoursSpecification }),
  ...(aggregateRating && { aggregateRating }),
};

// Two keys means only @context and @id — nothing worth emitting.
const hasBusinessExtras = Object.keys(businessExtras).length > 2;

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Suppress the chat widget. Set on checkout and post-payment pages. */
  noChat?: boolean;
  /** Suppress the mobile sticky booking bar (already the action, or post-purchase). */
  noStickyCta?: boolean;
  /**
   * Per-page link-preview card, root-relative (e.g. "/og/faq.jpg"). Cards live
   * in public/og/ and are built by scripts/generate-og-images.mjs; that script
   * is the only place to add or change one. Pages without their own card fall
   * back to the site card below, which is the right answer for the legal pages
   * and for anything transactional.
   */
  ogImage?: string;
  /** Alt text for the card. Defaults to the page title. */
  ogImageAlt?: string;
}
const {
  title = "Pro Se Fair Play Mediation LLC",
  description = "Mediation and document preparation for self-represented individuals. I help you walk into court informed, prepared, and never alone.",
  noindex = false,
  noChat = false,
  noStickyCta = false,
  ogImage = "/og-image.jpg",
  ogImageAlt,
} = Astro.props;

const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Ad-click capture. Runs before anything else on the page and before the
      analytics script has loaded, because the one thing that cannot be
      recovered later is a click ID that was never read off the URL. See
      src/lib/attribution.ts and docs/marketing/google-attribution.md.
    */}
    <script is:inline define:vars={{ ATTR_KEY: ATTRIBUTION_KEY, ATTR_TTL: ATTRIBUTION_TTL_DAYS }}>
      (function () {
        var FIELDS = [
          "gclid", "gbraid", "wbraid",
          "utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content",
        ];

        try {
          var params = new URLSearchParams(window.location.search);
          var touch = {};
          var found = false;
          for (var i = 0; i < FIELDS.length; i++) {
            var value = (params.get(FIELDS[i]) || "").slice(0, 200);
            if (value) { touch[FIELDS[i]] = value; found = true; }
          }

          var stored = {};
          try { stored = JSON.parse(localStorage.getItem(ATTR_KEY) || "{}") || {}; } catch (e) {}

          // Expire the whole record together. A ninety-day-old click ID is no
          // longer accepted by Google anyway, and a half-expired record is
          // harder to reason about than none.
          var maxAge = ATTR_TTL * 86400000;
          if (stored.first_seen && Date.now() - Date.parse(stored.first_seen) > maxAge) stored = {};

          if (found) {
            touch.landing_page = window.location.pathname;
            // Only an off-site referrer says anything; an internal one is noise.
            var ref = document.referrer || "";
            if (ref && ref.indexOf(window.location.host) === -1) touch.referrer = ref.slice(0, 300);

            // First touch is written once and never overwritten -- on a
            // months-long decision it is usually the one that earned the lead.
            if (!stored.first) { stored.first = touch; stored.first_seen = new Date().toISOString(); }
            stored.last = touch;
            stored.last_seen = new Date().toISOString();
            try { localStorage.setItem(ATTR_KEY, JSON.stringify(stored)); } catch (e) {}
          }

          // Read back by the capture form. Absent rather than empty when
          // nothing was ever captured, so a direct visit sends no noise.
          window.__pfpAttribution = stored.first || stored.last ? stored : null;
        } catch (e) {
          // Private browsing, a blocked storage API, an exotic URL. None of it
          // is worth breaking a page over.
          window.__pfpAttribution = null;
        }
      })();
    </script>

    <!-- Google Analytics (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NH6HKR18MZ"></script>
    <script is:inline define:vars={{ AW_ID: AW_CONVERSION_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NH6HKR18MZ');

      // Google Ads. Configured only once AW_CONVERSION_ID is filled in, so
      // the site carries no Ads tag until there is an account to send to.
      // allow_enhanced_conversions lets the tag hash and send the email the
      // visitor typed, which is what matches a later CRM conversion back to
      // the click. Nothing is sent by merely configuring this.
      if (AW_ID) {
        gtag('config', AW_ID, { allow_enhanced_conversions: true });
      }

      // Delegated listener: any click on a /book link anywhere on
      // the site fires a single book_intent_click event. Source is
      // the path the user clicked from so we can see where bookings
      // originate without per-button onclicks scattered everywhere.
      document.addEventListener("click", function (e) {
        var link = e.target && e.target.closest && e.target.closest('a[href="/book"]');
        if (!link) return;
        if (typeof window.gtag === "function") {
          window.gtag("event", "book_intent_click", {
            source: window.location.pathname,
          });
        }
      });
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {BING_SITE_VERIFICATION && (
      <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />
    )}
    <meta name="theme-color" content="#1B2D5A" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />

    <!-- Favicon bundle (maximalist: classic + modern + iOS + Android) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Pro Se Fair Play" />

    <!-- Open Graph / link-preview tags (iMessage, Slack, Facebook, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pro Se Fair Play Mediation LLC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <!-- 1200x630, the size Facebook, LinkedIn, Slack and iMessage all size
         their preview cards to. The old 648x395 logo was below every one of
         those and rendered soft or letterboxed.

         Every card is generated at exactly 1200x630, so the width and height
         below hold for the per-page cards as well as the default. If a card
         is ever produced at another size these two have to move with it. -->
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? title} />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org structured data for the business. Using
         ProfessionalService rather than LegalService to stay
         consistent with the site's "not a law firm" disclaimer.

         PENDING: the Florida Supreme Court family mediator certification is
         in progress and NOT yet approved, so it is deliberately absent here.

         THIS LIST IS THE CANONICAL ONE. Six files now suppress the claim; an
         earlier version of this comment named only three, which would have
         meant restoring half of them and silently leaving the rest wrong.
         If you add a seventh, add it here too.

         When the certification is granted:
           1. "description" below, and "founder.jobTitle" if it should lead
           2. the About page credentials array (src/pages/about.astro)
           3. the About page meta description (src/pages/about.astro)
           4. src/components/ArticleSchema.astro — the author block may then
              carry the credential
           5. src/components/ServiceSchema.astro — likewise the provider block
           6. src/pages/services/divorce-mediation.astro — its own inline
              Service block

         And the substantive one, which is a content change rather than a
         one-line edit:
           7. src/pages/areas-served.astro — every county section currently
              describes the circuit's programme as the COURT'S and this
              practice as the private alternative, because court-referred
              family work requires this certification. Once approved, each
              section can gain a court-referred paragraph. That page is the
              one that reaches people who already have a case filed, so it is
              the biggest single unlock.

         Also worth revisiting at that point: scripts/compliance-check.mjs has
         a "certification-claim" rule that will fail the automated article
         pipeline on any mention of a certified mediator. It is correct today.
         Relax it only after the certificate is actually in hand.

         Do not re-add the claim anywhere before approval. -->
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": "https://prosefairplaymediation.com/#business",
      "name": "Pro Se Fair Play Mediation LLC",
      "alternateName": "Pro Se Fair Play Mediation",
      "url": "https://prosefairplaymediation.com",
      "description": "High-Conflict Resolution Mediator providing professional mediation and court-ready family law document preparation for self-represented (pro se) individuals.",
      "email": "info@prosefairplaymediation.com",
      "telephone": "+1-561-941-0896",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "700 South Rosemary Avenue, Suite 204",
        "addressLocality": "West Palm Beach",
        "addressRegion": "FL",
        "postalCode": "33401",
        "addressCountry": "US"
      },
      "//geo": "Coordinates and map link both come from the business's own Google Maps listing rather than being looked up or estimated: geo from the @lat,lon in the place URL, hasMap from the same listing's CID. Sanity-checked at 0.92km from West Palm Beach centre, consistent with the Rosemary Avenue address. Do not replace these with approximations.",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 26.7089822,
        "longitude": -80.0593779
      },
      "hasMap": "https://maps.google.com/?cid=18045141084315672576",
      "image": "https://prosefairplaymediation.com/logo_BG_color_Cropped.png",
      "logo": "https://prosefairplaymediation.com/logo_BG_color_Cropped.png",
      "founder": {
        "@type": "Person",
        "name": "Marie VanGinHoven",
        "jobTitle": "High-Conflict Resolution Mediator"
      },
      "priceRange": "$600-$4800",
      "areaServed": [
        { "@type": "State", "name": "Florida" },
        { "@type": "AdministrativeArea", "name": "Palm Beach County, Florida" },
        { "@type": "AdministrativeArea", "name": "Broward County, Florida" },
        { "@type": "AdministrativeArea", "name": "Miami-Dade County, Florida" },
        { "@type": "AdministrativeArea", "name": "Martin County, Florida" },
        { "@type": "AdministrativeArea", "name": "St. Lucie County, Florida" },
        { "@type": "City", "name": "West Palm Beach" }
      ],
      "availableChannel": {
        "@type": "ServiceChannel",
        "name": "Online mediation via Zoom",
        "serviceUrl": "https://prosefairplaymediation.com/book"
      },
      "serviceType": [
        "Family Mediation",
        "Divorce Mediation",
        "High-Conflict Resolution Mediation",
        "Parenting Plan Preparation",
        "Paternity Mediation",
        "Mediated Settlement Agreement Preparation",
        "Marital Home and Real Estate Settlement Mediation",
        "Mediation Preparation Sessions",
        "Family Law Document Preparation",
        "Real Estate Mediation",
        "Pre-Litigation Mediation",
        "Private Business and Civil Mediation",
        "Online Notary Services"
      ],
      "knowsAbout": [
        "Family Law Mediation",
        "Divorce Mediation in Florida",
        "High-Conflict Resolution",
        "Parenting Plans",
        "Florida Child Support Guidelines",
        "Florida Alimony Law",
        "Florida Supreme Court Family Law Forms",
        "Self-Represented Litigation Support",
        "Pro Se Document Preparation",
        "Real Estate and Marital Property Mediation",
        "Pre-Litigation Dispute Resolution"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "url": "https://prosefairplaymediation.com/services/hourly-mediation",
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": "600.00",
              "priceCurrency": "USD",
              "unitText": "HUR"
            },
            "itemOffered": {
              "@type": "Service",
              "name": "Hourly Family Mediation",
              "description": "Neutral, structured family mediation conducted via Zoom."
            }
          },
          {
            "@type": "Offer",
            "url": "https://prosefairplaymediation.com/services/parenting-plan",
            "price": "600.00",
            "priceCurrency": "USD",
            "itemOffered": {
              "@type": "Service",
              "name": "Parenting Plan Preparation",
              "description": "Customized Parenting Plan tailored to your family, delivered in a clear, court-ready format."
            }
          },
          {
            "@type": "Offer",
            "url": "https://prosefairplaymediation.com/services/court-packet",
            "//price": "No price is declared: as of 2026-09-02 the packet is quoted by case type. An Offer stating a fixed figure for something quoted per case would be a wrong answer rather than a rounded one, and search engines repeat it.",
            "availability": "https://schema.org/InStock",
            "itemOffered": {
              "@type": "Service",
              "name": "Turn-Key Court Packet",
              "description": "Complete family law document package, professionally organized and assembled into a filing-ready packet with notarization where applicable. Priced by the type and complexity of the case."
            }
          }
        ]
      },
      "//": "sameAs links this site to the same business elsewhere. It is the entity-resolution signal: without it, engines can read the website, the Google listing and the Bing listing as three similarly-named South Florida practices rather than one. Only add profiles that genuinely represent this business, and only URLs that are publicly live. A wrong or dead URL here actively confuses the thing it exists to fix. The Google entry is the canonical ?cid= form, derived from the CID in the Maps place URL, because that is stable; a copied /maps/place/ URL carries viewport coordinates that change. Yelp and Bing Places listings exist and go in here once they are publicly visible.",
      "sameAs": [
        "https://maps.google.com/?cid=18045141084315672576"
      ]
    }
    </script>

    {hasBusinessExtras && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(businessExtras)}
      />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap"
    />
  </head>
  <body>
    <a href="#main" class="sr-only">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MusicPlayer />
    {!noChat && <ChatWidget />}
    {!noStickyCta && <StickyCta />}

    {/*
      Floating bottom-left slogan — disabled in favor of an in-nav slogan.
      Kept here (and styles in global.css) for potential future re-enable.

      NOTE: the script below hooks .footer-motto, which no longer exists — the
      footer's slogan and company name were removed on 2026-09-02 as redundant
      with the nav. Re-enabling this needs that reference replaced with
      something that is still on the page.

      <aside class="floating-slogan" aria-hidden="true">
        <span class="floating-slogan-text">Where we level the playing field.</span>
      </aside>

      <script is:inline>
        (function () {
          const slogan = document.querySelector(".floating-slogan");
          const footerMotto = document.querySelector(".footer-motto");
          if (!slogan || !footerMotto) return;

          requestAnimationFrame(() => {
            requestAnimationFrame(() => slogan.classList.add("is-visible"));
          });

          const obs = new IntersectionObserver(
            (entries) => {
              const entry = entries[0];
              slogan.classList.toggle("is-docked", entry.isIntersecting);
            },
            { rootMargin: "0px 0px -20px 0px", threshold: 0 }
          );
          obs.observe(footerMotto);
        })();
      </script>
    */}
  </body>
</html>
