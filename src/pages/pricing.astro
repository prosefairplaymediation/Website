---
import BaseLayout from "../layouts/BaseLayout.astro";
import fs from "node:fs";

// The Zelle QR must be exported from the bank: the code encodes a
// bank-issued token, so unlike the Stripe codes on /pay it cannot be
// generated here. Gate the section on the file actually being present so
// the page never ships a broken image, and so dropping the export into
// public/ is the only step needed to turn it on.
const hasZelleQr = fs.existsSync("public/zelle-qr.png");

// Service-level pricing, pulled from the individual service pages.
const services = [
  {
    name: "Hourly Mediation",
    price: "$600 / hour",
    note: "Combined rate, commonly split evenly between both parties ($300 each per hour). Book a single hour, half-day, or full-day session.",
    href: "/services/hourly-mediation",
    payHref: "/pay#mediation",
  },
  {
    name: "Gold Service Mediation",
    price: "Inquire within",
    note: "Premium, private mediation for high-profile individuals and sensitive or high-conflict matters. Discreet, with elevated scheduling and confidentiality. Arrangements are built around the matter \u2014 which can include a private off-site venue or a multi-day format \u2014 so pricing is quoted individually.",
    href: "/services/gold-service",
    payHref: "/services/gold-service",
  },
  {
    name: "Parenting Plan Preparation",
    price: "$400 flat",
    note: "A customized, court-ready Parenting Plan, drafted from the information you provide. Document preparation only.",
    href: "/services/parenting-plan",
    payHref: "/pay#document-services",
  },
  {
    name: "Turn-Key Court Packet",
    price: "$600 flat",
    note: "A complete, filing-ready packet: Parenting Plan, the required Florida Supreme Court forms, and notarization where applicable.",
    href: "/services/court-packet",
    payHref: "/pay#document-services",
  },
];
import FaqBlock from "../components/FaqBlock.astro";
import InlineScheduler from "../components/InlineScheduler.astro";
import LeadCapture from "../components/LeadCapture.astro";
---

<BaseLayout
  title="Pricing · Pro Se Fair Play Mediation"
  description="Up-front pricing for mediation and document preparation services, plus the refund and cancellation policies that apply to each."
  ogImage="/og/pricing.jpg"
>
  <!-- ========================== HEADER ========================== -->
  <header class="pricing-header">
    <div class="container pricing-header-inner">
      <p class="kicker reveal reveal-d1">
        <span class="kicker-dot" aria-hidden="true"></span>
        Fees &amp; Policies
      </p>
      <h1 class="display pricing-title reveal reveal-d2">
        Pricing<span class="display-italic">.</span>
      </h1>
      <p class="lede reveal reveal-d3">
        Clear, up-front pricing for every service, plus the refund and
        cancellation policies that go with it. No surprises. You can also
        always pay by <img src="/zelleword.svg" alt="Zelle" class="zelle-mark" /> to Pro Se Fair Play Mediation at (561) 941-0896.
      </p>
    </div>
  </header>

  <!-- ========================== PRICING ========================== -->
  <section class="pricing-body">
    <div class="container-narrow">
      <h2 class="section-label">Services</h2>
      <ul class="price-list" role="list">
        {services.map((s) => (
          <li class="price-row">
            <div class="price-row-info">
              <h3 class="price-row-name display">
                <a href={s.href}>{s.name}</a>
              </h3>
              <p class="price-row-note">{s.note}</p>
            </div>
            <div class="price-row-action">
              <p class="price-row-amount smallcaps">{s.price}</p>
              {s.payHref && (
                <a class="btn btn-primary price-row-btn" href={s.payHref} aria-label={`Book now: ${s.name}`}>
                  Book Now
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/*
    Scan to pay by Zelle.

    Renders only when public/zelle-qr.png actually exists, so the page can
    never ship a broken image placeholder. Drop the file in and the section
    appears on the next build with no code change; remove it and the section
    disappears cleanly.

    The QR has to be the bank's own export. A Zelle code encodes a
    bank-issued token, not just a phone number, so it cannot be generated
    here the way the Stripe codes on /pay are.
  */}
  {hasZelleQr && (
    <section class="pricing-body zelle-scan-section">
      <div class="container-narrow">
        <h2 class="section-label">Scan to Pay by Zelle</h2>
        <div class="zelle-scan">
          <div class="zelle-scan-code">
            <img
              src="/zelle-qr.png"
              alt="Zelle QR code for Pro Se Fair Play Mediation LLC at (561) 941-0896"
              width="240" height="240"
              loading="lazy"
            />
          </div>
          <div class="zelle-scan-text">
            <p class="zelle-scan-lede">
              Open your banking app, scan this code, and the payment is
              addressed to <strong>Pro Se Fair Play Mediation LLC</strong>
              automatically. No processing fee.
            </p>
            <p class="zelle-scan-note">
              Enter the amount for the service you agreed on and put your
              name in the memo. Please read the{" "}
              <a class="link-underline" href="/pay/agreement" target="_blank" rel="noopener">
                Engagement Agreement
              </a>{" "}
              before paying. A Zelle payment does not send you to a
              scheduling page the way the card options do, so book your
              session separately once it clears.
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ========================== REFUND POLICIES ========================== -->
  <section class="pricing-body pricing-body-alt">
    <div class="container-narrow">
      <h2 class="section-label">Refund &amp; Cancellation</h2>
      <p class="policy-summary-lead">
        Both policies now have pages of their own, so they can be read, linked
        to and cited without scrolling through a price list. The short version:
      </p>
      <ul class="policy-summary-list">
        <li>
          More than <strong>24 hours'</strong> notice on a mediation session — full
          refund or a full session credit, your choice.
        </li>
        <li>
          Less than 24 hours — <strong>50%</strong> of the retainer is retained,
          and the balance becomes a one-time credit toward a session within 30 days.
        </li>
        <li>
          <strong>If the other party declines to mediate at all, the paying party is
          refunded in full</strong>, whatever the notice.
        </li>
        <li>
          Document preparation is fully refundable <strong>before</strong> drafting
          starts, and earned once it has.
        </li>
        <li>
          Hurricanes, evacuation orders and outages are rescheduled at no charge.
        </li>
      </ul>
      <p class="policy-summary-links">
        <a class="link-underline" href="/cancellation">Cancellation &amp; Rescheduling Policy</a>
        <span aria-hidden="true"> &middot; </span>
        <a class="link-underline" href="/refund">Refund Policy</a>
      </p>
    </div>
  </section>

  {/* Calendar inline, not a link to one — this is where the reader is
      already at peak intent. Lazy-loaded on scroll. */}
  <FaqBlock set="pricing" heading="Questions about fees and payment" />
  <InlineScheduler source="pricing" />
  <LeadCapture source="pricing" />
</BaseLayout>

<style>
  /* ============================================================
     HEADER
     ============================================================ */
  .pricing-header {
    position: relative;
    padding-block: clamp(4rem, 6vw + 1rem, 6rem) clamp(2rem, 3vw, 3rem);
    background:
      radial-gradient(ellipse at 80% 20%, rgba(196, 154, 75, 0.08), transparent 55%),
      var(--color-cream);
    border-bottom: 1px solid var(--color-divider);
    overflow: hidden;
  }
  .pricing-header-inner { position: relative; max-width: 64rem; }
  .pricing-title {
    margin-top: 1rem;
    font-size: var(--step-5);
    line-height: 1.02;
    color: var(--color-navy);
    letter-spacing: -0.025em;
    font-weight: 400;
  }
  .pricing-title .display-italic { color: var(--color-gold-deep); font-weight: 400; }
  .pricing-header .lede { margin-top: 1.5rem; max-width: 60ch; color: var(--color-ink-soft); }
  .zelle-mark { display: inline-block; height: 0.95em; width: auto; vertical-align: -0.1em; margin: 0 0.15em; }

  /* ============================================================
     SCAN TO PAY BY ZELLE
     ============================================================ */
  .zelle-scan-section { border-top: 1px solid var(--color-divider); }
  .zelle-scan {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-lg);
    align-items: start;
    background: var(--color-paper);
    border: 1px solid var(--color-divider);
    border-top: 2px solid var(--color-gold);
    padding: 1.75rem;
    box-shadow:
      0 1px 2px rgba(18, 33, 74, 0.04),
      0 12px 32px -16px rgba(18, 33, 74, 0.15);
  }
  .zelle-scan-code img {
    display: block;
    width: 11rem;
    height: auto;
    border: 1px solid var(--color-divider);
    padding: 0.4rem;
    /* Pure white on purpose, not --color-paper: a QR code needs a true-white
       quiet zone to scan reliably in poor light. */
    background: #fff;
  }
  .zelle-scan-text { display: flex; flex-direction: column; gap: 0.9rem; }
  .zelle-scan-lede {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
    margin: 0;
  }
  .zelle-scan-lede strong { color: var(--color-navy); font-weight: 600; }
  .zelle-scan-note {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-slate);
    max-width: 62ch;
  }

  @media (max-width: 40rem) {
    .zelle-scan { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .zelle-scan-note { text-align: left; }
  }

  /* ============================================================
     BODY BANDS
     ============================================================ */
  .pricing-body {
    padding-block: var(--space-2xl);
    background: var(--color-cream);
  }
  /* Tighten the first section up under the header. */
  .pricing-body:first-of-type {
    padding-top: var(--space-md);
  }
  .pricing-body-alt {
    background: var(--color-cream-warm);
    border-top: 1px solid var(--color-divider);
  }
  .section-label {
    margin: 0 0 var(--space-md);
    font-size: 1.2rem;
    color: var(--color-gold-deep);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  /* ============================================================
     PRICE LIST
     ============================================================ */
  .price-list { list-style: none; padding: 0; margin: 0; }
  .price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-divider);
  }
  .price-row:last-child { border-bottom: 1px solid var(--color-divider); }
  .price-row-info { min-width: 0; }
  .price-row-name {
    font-size: var(--step-2);
    line-height: 1.15;
    color: var(--color-navy);
    letter-spacing: -0.01em;
    font-weight: 400;
    margin: 0 0 0.4rem;
  }
  .price-row-name a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-gold) 55%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .price-row-name a:hover,
  .price-row-name a:focus-visible {
    color: var(--color-gold-deep);
    text-decoration-color: var(--color-gold-deep);
  }
  .price-row-note {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 60ch;
  }
  .price-row-action {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }
  .price-row-amount {
    margin: 0;
    font-size: 1.5rem;
    color: var(--color-gold-deep);
    font-weight: 700;
    letter-spacing: 0.08em;
    white-space: nowrap;
    text-align: right;
  }
  .price-row-btn {
    padding: 0.55rem 1.1rem;
    font-size: 0.85rem;
    white-space: nowrap;
    background: var(--color-navy);
    color: var(--color-cream);
    border-color: var(--color-navy);
  }
  .price-row-btn:hover {
    background: var(--color-navy-deep);
    color: var(--color-cream);
    border-color: var(--color-gold);
  }

  /* ============================================================
     POLICIES
     ============================================================ */
  .policy + .policy {
    margin-top: var(--space-2xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-divider);
  }
  .policy-summary-lead { max-width: 62ch; line-height: 1.7; }
  .policy-summary-list {
    max-width: 66ch;
    margin: var(--space-md) 0;
    padding-left: 1.15rem;
    line-height: 1.7;
  }
  .policy-summary-list li { margin-bottom: 0.55rem; }
  .policy-summary-links { margin-top: var(--space-lg); font-size: 1.02rem; }
  .policy-title {
    font-size: var(--step-3);
    line-height: 1.1;
    color: var(--color-navy);
    letter-spacing: -0.015em;
    font-weight: 400;
    margin-bottom: 1.25rem;
  }
  .policy-body {
    font-family: var(--font-body);
    font-size: var(--step-1);
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: 64ch;
  }
  .policy-body p + p { margin-top: 1.25rem; }
  .policy-subhead {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24;
    font-size: 1.3rem;
    line-height: 1.25;
    color: var(--color-navy);
    letter-spacing: -0.005em;
    font-weight: 500;
  }
  .policy-list {
    margin: 0.75rem 0 1.25rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .policy-list li { line-height: 1.55; }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 600px) {
    .pricing-title { font-size: clamp(2.25rem, 1.8rem + 3vw, 3.5rem); }
    .price-row { flex-direction: column; gap: 0.75rem; }
    .price-row-amount { text-align: left; }
    .price-row-action { align-items: flex-start; }
  }
</style>
