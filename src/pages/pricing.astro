---
import BaseLayout from "../layouts/BaseLayout.astro";
import { QUOTED_AMOUNT_URL } from "../consts.ts";
import fs from "node:fs";

// The Zelle QR must be exported from the bank: the code encodes a
// bank-issued token, so unlike the Stripe codes on /pay it cannot be
// generated here. Gate the section on the file actually being present so
// the page never ships a broken image, and so dropping the export into
// public/ is the only step needed to turn it on.
const hasZelleQr = fs.existsSync("public/zelle-qr.png");

/**
 * The full services and pricing list, supplied by Marie on 2026-09-02.
 *
 * This page is the one place every price is stated together, so it is the one
 * that has to be right. Three rules it follows:
 *
 *  - A row gets a Pay Now button only where there is a fixed amount to charge.
 *    Anything quoted individually shows "Inquire within" as its price and no
 *    button: a pay button beside a variable price invites someone to pay the
 *    wrong amount, and there is no graceful way to ask for the rest later.
 *  - `href` is omitted where no page exists yet rather than pointed at
 *    something approximate. The name then renders unlinked.
 *  - The wording follows the copy supplied, condensed for a list. Full
 *    descriptions belong on each service's own page.
 */
interface PriceRow {
  name: string;
  price: string;
  note: string;
  /** Omit when the service has no page of its own yet. */
  href?: string;
  /** Omit for anything without a fixed amount payable up front. Rows without
   *  one show no button at all — the price reads "Inquire within", which is
   *  the instruction, and a button beside it would only compete with it. */
  payHref?: string;
}

const services: PriceRow[] = [
  {
    name: "Hourly Mediation",
    price: "$600 / hour",
    note: "Private mediation to work through disagreements and reach mutually acceptable resolutions in a confidential, structured setting. The combined rate is commonly divided equally between the parties at $300 each per hour. Available for divorce, parenting, paternity, property, financial, real estate and other family-related disputes.",
    href: "/services/hourly-mediation",
    payHref: "/pay#mediation",
  },
  {
    name: "Divorce Mediation & Document Preparation",
    price: "$600 / hour",
    note: "For couples who want to move through divorce privately and respectfully, without unnecessary litigation. May include mediation of marital issues, a Mediated Settlement Agreement, parenting matters, division of assets and liabilities, marital residence provisions, and preparation of the applicable Florida Supreme Court approved family-law forms for pro se filing. Priced on the complexity of the matter and the services required.",
    href: "/services/divorce-mediation",
    payHref: "/pay#mediation",
  },
  {
    name: "Pre-Litigation Dispute Resolution",
    price: "$600 / hour \u00b7 two-hour minimum",
    note: "Private, confidential resolution for people who want to address a conflict before it becomes litigation. May include facilitated negotiation over family disputes, separation terms, property and real estate, financial obligations and other matters where the parties want a structured written agreement reached privately. Minimum engagement two hours ($1,200).",
    payHref: "/pay#mediation",
  },
  {
    name: "Paternity Mediation & Document Preparation",
    price: "$600 / hour",
    note: "For unmarried parents resolving parenting and paternity matters. May include mediation of parental responsibility, timesharing, Parenting Plans, child support, expenses for the child, holidays, travel and communication, along with preparation of the applicable documents for pro se filing.",
    payHref: "/pay#mediation",
  },
  {
    name: "Marital Home & Real Estate Settlement Mediation",
    price: "$600 / hour",
    note: "Private mediation for couples, former partners or co-owners resolving jointly owned real estate. May cover sale of the property, refinancing, buyouts, responsibility for the mortgage and carrying costs, repairs, selection of a realtor, distribution of proceeds and timelines.",
    payHref: "/pay#mediation",
  },
  {
    name: "One-on-One Mediation Preparation Session",
    price: "$600 / hour",
    note: "Private preparation for an upcoming mediation: review the issues, organize financial and property information, identify priorities, and prepare for productive settlement discussions. This is preparation and education. It is not legal representation and it is not legal advice.",
    payHref: "/pay#mediation",
  },
  {
    name: "Parenting Plan Preparation",
    price: "$600 flat",
    note: "A customized Parenting Plan prepared from the information the parties provide. May address parental responsibility, timesharing, holidays, school schedules, transportation, travel, communication and decision-making. Document preparation only.",
    href: "/services/parenting-plan",
    // No pay button until the Stripe link charges $600. It was confirmed on
    // 2026-09-02 to still be charging $400, and a button that quietly takes
    // two thirds of the advertised price is worse than no button. Restore
    // payHref: "/pay#document-services" once Stripe matches.
    cta: "Inquire",
  },
  {
    name: "Mediated Settlement Agreement Preparation",
    price: "$600 / hour",
    note: "A customized written settlement agreement recording the terms the parties have reached. May address marital property, real estate, debts, financial responsibilities, parenting matters, support, and the sale or refinancing of property.",
    payHref: "/pay#mediation",
  },
  {
    name: "Turn-Key Court Packet",
    price: "$600 flat",
    note: "Complete document preparation for eligible pro se family-law matters. Depending on the case, the packet may include the applicable Florida Supreme Court approved family-law forms, financial documents, a Parenting Plan, settlement documents, and any other forms the filing requires.",
    href: "/services/court-packet",
    payHref: "/pay#document-services",
  },
  {
    name: "Gold Service Mediation",
    price: "Inquire within",
    note: "Premium, private mediation for high-profile individuals and for sensitive or high-conflict matters, built for clients who place a premium on privacy, discretion, confidentiality, scheduling flexibility and personalized service. Arrangements may include private off-site venues, extended sessions and multi-day mediation. Once a figure is quoted, it can be paid online.",
    href: "/services/gold-service",
    // Pay Now only once the quoted-amount link exists. Until then the row
    // reads "Inquire within" with no button, which is honest; a button
    // leading nowhere is not.
    payHref: QUOTED_AMOUNT_URL ? "/pay#quoted-amount" : undefined,
  },
  {
    name: "Additional Document Preparation",
    price: "Inquire within",
    note: "Something that does not fit neatly above? Additional agreements, family-law documents, amendments, supplemental documents and customized preparation may be available, priced on the scope and complexity of the work. Once a figure is quoted, it can be paid online.",
    payHref: QUOTED_AMOUNT_URL ? "/pay#quoted-amount" : undefined,
  },
];
import FaqBlock from "../components/FaqBlock.astro";
import InlineScheduler from "../components/InlineScheduler.astro";
import LeadCapture from "../components/LeadCapture.astro";
---

<BaseLayout
  title="Pricing · Pro Se Fair Play Mediation"
  description="Up-front pricing for mediation and document preparation services, plus the refund and cancellation policies that apply to each."
  ogImage="/og/pricing.jpg"
>
  <!-- ========================== HEADER ========================== -->
  <header class="pricing-header">
    <div class="container pricing-header-inner">
      <p class="kicker reveal reveal-d1">
        <span class="kicker-dot" aria-hidden="true"></span>
        Fees &amp; Policies
      </p>
      <h1 class="display pricing-title reveal reveal-d2">
        Pricing<span class="display-italic">.</span>
      </h1>
      <p class="lede reveal reveal-d3">
        Clear, up-front pricing for every service, plus the refund and
        cancellation policies that go with it. No surprises. You can also
        always pay by <img src="/zelleword.svg" alt="Zelle" class="zelle-mark" width="245" height="100" /> to Pro Se Fair Play Mediation at (561) 941-0896.
      </p>
    </div>
  </header>

  <!-- ========================== PRICING ========================== -->
  <section class="pricing-body">
    <div class="container-narrow">
      <h2 class="section-label">Services</h2>
      <ul class="price-list" role="list">
        {services.map((s) => (
          <li class="price-row">
            <div class="price-row-info">
              {/* Unlinked where the service has no page of its own yet. The
                  heading reads the same; it simply is not a link. */}
              <h3 class="price-row-name display">
                {s.href ? <a href={s.href}>{s.name}</a> : s.name}
              </h3>
              <p class="price-row-note">{s.note}</p>
            </div>
            <div class="price-row-action">
              <p class="price-row-amount smallcaps">{s.price}</p>
              {s.payHref && (
                <a class="btn btn-primary price-row-btn" href={s.payHref} aria-label={`Pay now: ${s.name}`}>
                  Pay Now
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/*
    Scan to pay by Zelle.

    Renders only when public/zelle-qr.png actually exists, so the page can
    never ship a broken image placeholder. Drop the file in and the section
    appears on the next build with no code change; remove it and the section
    disappears cleanly.

    The QR has to be the bank's own export. A Zelle code encodes a
    bank-issued token, not just a phone number, so it cannot be generated
    here the way the Stripe codes on /pay are.
  */}
  {hasZelleQr && (
    <section class="pricing-body zelle-scan-section">
      <div class="container-narrow">
        <h2 class="section-label">Scan to Pay by Zelle</h2>
        <div class="zelle-scan">
          <div class="zelle-scan-code">
            <img
              src="/zelle-qr.png"
              alt="Zelle QR code for Pro Se Fair Play Mediation LLC at (561) 941-0896"
              width="240" height="240"
              loading="lazy"
            />
          </div>
          <div class="zelle-scan-text">
            <p class="zelle-scan-lede">
              Open your banking app, scan this code, and the payment is
              addressed to <strong>Pro Se Fair Play Mediation LLC</strong>
              automatically. No processing fee.
            </p>
            <p class="zelle-scan-note">
              Enter the amount for the service you agreed on and put your
              name in the memo. Please read the{" "}
              <a class="link-underline" href="/pay/agreement" target="_blank" rel="noopener">
                Engagement Agreement
              </a>{" "}
              before paying. A Zelle payment does not send you to a
              scheduling page the way the card options do, so book your
              session separately once it clears.
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ========================== REFUND POLICIES ========================== -->
  <section class="pricing-body pricing-body-alt">
    <div class="container-narrow">
      <h2 class="section-label">Refund &amp; Cancellation Policies</h2>

      <article class="policy">
        <h3 class="policy-title display">Mediation</h3>
        <div class="policy-body">
          <p>
            At Pro Se Fair Play Mediation LLC, mediation sessions involve
            reserved professional time, scheduling coordination between
            parties, and advance preparation to ensure a productive and
            structured process. I understand that life happens and strive
            to maintain a policy that is both fair to clients and
            respectful of the time reserved for each matter.
          </p>

          <h4 class="policy-subhead">Cancellations &amp; Rescheduling</h4>
          <p>
            Cancellations or rescheduling requests made more than
            twenty-four (24) hours prior to a scheduled session are
            eligible for either:
          </p>
          <ul class="policy-list">
            <li>a full refund to the original payment method, or</li>
            <li>a full session credit to be applied toward a future mediation session.</li>
          </ul>
          <p>
            For cancellations made less than twenty-four (24) hours
            before the scheduled session, fifty percent (50%) of the
            mediation retainer will be retained as a reserved session
            and preparation fee. The remaining balance may be applied
            as a one-time credit toward a rescheduled session scheduled
            within thirty (30) days, subject to availability.
          </p>
          <p>
            Clients who fail to appear for a scheduled mediation session
            without notice will forfeit the full mediation retainer.
          </p>

          <h4 class="policy-subhead">Courtesy Rescheduling</h4>
          <p>
            One courtesy reschedule may be accommodated for unforeseen
            circumstances, provided reasonable notice is given and
            scheduling availability permits.
          </p>

          <h4 class="policy-subhead">Emergency Circumstances</h4>
          <p>
            Emergency situations and unforeseen events may be considered
            on a case-by-case basis at the sole discretion of Pro Se
            Fair Play Mediation LLC.
          </p>

          <h4 class="policy-subhead">Refund Processing</h4>
          <p>
            Approved refunds will be processed to the original payment
            method. Processing times may vary depending on the financial
            institution or payment provider.
          </p>

          <h4 class="policy-subhead">Reserved Professional Time</h4>
          <p>
            By scheduling a mediation session, clients acknowledge that
            mediation appointments involve reserved professional time
            and preparation that cannot typically be reassigned on short
            notice. This policy is intended to maintain fairness,
            scheduling integrity, and availability for all parties.
          </p>
        </div>
      </article>

      <article class="policy">
        <h3 class="policy-title display">Document Preparation</h3>
        <div class="policy-body">
          <p>
            Document preparation services are customized for each client
            and matter. Because of the time, attention, and preparation
            involved, refunds are available prior to the start of
            drafting or document preparation work.
          </p>
          <p>
            Once work has begun, payments may be applied as a credit
            toward ongoing or future services based on the status of the
            matter and the work completed.
          </p>
          <p>
            Once completed drafts or finalized documents have been
            delivered, services are considered earned and non-refundable.
          </p>
          <p>
            I understand that unexpected situations can arise, and
            reasonable requests related to unforeseen circumstances will
            always be considered with care on a case-by-case basis.
          </p>
        </div>
      </article>
    </div>
  </section>

  {/* Calendar inline, not a link to one — this is where the reader is
      already at peak intent. Lazy-loaded on scroll. */}
  <FaqBlock set="pricing" heading="Questions about fees and payment" />
  <InlineScheduler source="pricing" />
  <LeadCapture source="pricing" />
</BaseLayout>

<style>
  /* ============================================================
     HEADER
     ============================================================ */
  .pricing-header {
    position: relative;
    padding-block: clamp(4rem, 6vw + 1rem, 6rem) clamp(2rem, 3vw, 3rem);
    background:
      radial-gradient(ellipse at 80% 20%, rgba(196, 154, 75, 0.08), transparent 55%),
      var(--color-cream);
    border-bottom: 1px solid var(--color-divider);
    overflow: hidden;
  }
  .pricing-header-inner { position: relative; max-width: 64rem; }
  .pricing-title {
    margin-top: 1rem;
    font-size: var(--step-5);
    line-height: 1.02;
    color: var(--color-navy);
    letter-spacing: -0.025em;
    font-weight: 400;
  }
  .pricing-title .display-italic { color: var(--color-gold-deep); font-weight: 400; }
  .pricing-header .lede { margin-top: 1.5rem; max-width: 60ch; color: var(--color-ink-soft); }
  .zelle-mark { display: inline-block; height: 0.95em; width: auto; vertical-align: -0.1em; margin: 0 0.15em; }

  /* ============================================================
     SCAN TO PAY BY ZELLE
     ============================================================ */
  .zelle-scan-section { border-top: 1px solid var(--color-divider); }
  .zelle-scan {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-lg);
    align-items: start;
    background: var(--color-paper);
    border: 1px solid var(--color-divider);
    border-top: 2px solid var(--color-gold);
    padding: 1.75rem;
    box-shadow:
      0 1px 2px rgba(18, 33, 74, 0.04),
      0 12px 32px -16px rgba(18, 33, 74, 0.15);
  }
  .zelle-scan-code img {
    display: block;
    width: 11rem;
    height: auto;
    border: 1px solid var(--color-divider);
    padding: 0.4rem;
    /* Pure white on purpose, not --color-paper: a QR code needs a true-white
       quiet zone to scan reliably in poor light. */
    background: #fff;
  }
  .zelle-scan-text { display: flex; flex-direction: column; gap: 0.9rem; }
  .zelle-scan-lede {
    font-family: var(--font-body);
    font-size: var(--step-0);
    line-height: 1.55;
    color: var(--color-ink-soft);
    margin: 0;
  }
  .zelle-scan-lede strong { color: var(--color-navy); font-weight: 600; }
  .zelle-scan-note {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step-sm);
    line-height: 1.6;
    color: var(--color-slate);
    max-width: 62ch;
  }

  @media (max-width: 40rem) {
    .zelle-scan { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .zelle-scan-note { text-align: left; }
  }

  /* ============================================================
     BODY BANDS
     ============================================================ */
  .pricing-body {
    padding-block: var(--space-2xl);
    background: var(--color-cream);
  }
  /* Tighten the first section up under the header. */
  .pricing-body:first-of-type {
    padding-top: var(--space-md);
  }
  .pricing-body-alt {
    background: var(--color-cream-warm);
    border-top: 1px solid var(--color-divider);
  }
  .section-label {
    margin: 0 0 var(--space-md);
    font-size: var(--step-1);
    color: var(--color-gold-deep);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  /* ============================================================
     PRICE LIST
     ============================================================ */
  .price-list { list-style: none; padding: 0; margin: 0; }
  .price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-divider);
  }
  .price-row:last-child { border-bottom: 1px solid var(--color-divider); }
  .price-row-info { min-width: 0; }
  .price-row-name {
    font-size: var(--step-2);
    line-height: 1.15;
    color: var(--color-navy);
    letter-spacing: -0.01em;
    font-weight: 400;
    margin: 0 0 0.4rem;
  }
  .price-row-name a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-gold) 55%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .price-row-name a:hover,
  .price-row-name a:focus-visible {
    color: var(--color-gold-deep);
    text-decoration-color: var(--color-gold-deep);
  }
  .price-row-note {
    font-family: var(--font-body);
    font-size: var(--step-0);
    line-height: 1.55;
    color: var(--color-ink-soft);
    max-width: 60ch;
  }
  .price-row-action {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }
  .price-row-amount {
    margin: 0;
    font-size: var(--step-2);
    color: var(--color-gold-deep);
    font-weight: 700;
    letter-spacing: 0.08em;
    white-space: nowrap;
    text-align: right;
  }
  .price-row-btn {
    padding: 0.55rem 1.1rem;
    font-size: var(--step-xs);
    white-space: nowrap;
    background: var(--color-navy);
    color: var(--color-cream);
    border-color: var(--color-navy);
  }
  .price-row-btn:hover {
    background: var(--color-navy-deep);
    color: var(--color-cream);
    border-color: var(--color-gold);
  }

  /* ============================================================
     POLICIES
     ============================================================ */
  .policy + .policy {
    margin-top: var(--space-2xl);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-divider);
  }
  /* .policy-summary-* removed with the refund summary block it styled. */
  .policy-title {
    font-size: var(--step-3);
    line-height: 1.1;
    color: var(--color-navy);
    letter-spacing: -0.015em;
    font-weight: 400;
    margin-bottom: 1.25rem;
  }
  .policy-body {
    font-family: var(--font-body);
    font-size: var(--step-1);
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: 64ch;
  }
  .policy-body p + p { margin-top: 1.25rem; }
  .policy-subhead {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24;
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--color-navy);
    letter-spacing: -0.005em;
    font-weight: 500;
  }
  .policy-list {
    margin: 0.75rem 0 1.25rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .policy-list li { line-height: 1.55; }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 600px) {
    .pricing-title { font-size: var(--step-4); }
    .price-row { flex-direction: column; gap: 0.75rem; }
    .price-row-amount { text-align: left; }
    .price-row-action { align-items: flex-start; }
  }
</style>
