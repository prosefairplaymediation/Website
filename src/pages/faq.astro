---
import BaseLayout from "../layouts/BaseLayout.astro";
import { faqs } from "../lib/faq.ts";

---

<BaseLayout
  title="Frequently Asked Questions · Pro Se Fair Play Mediation"
  description="Answers to the most common questions about mediation, fairness, confidentiality, and what to expect from working with Pro Se Fair Play Mediation."
  ogImage="/og/faq.jpg"
>
  {/*
    FAQPage structured data, generated from the same `faqs` array the page
    renders below, so the markup can never drift from the visible copy —
    which is a hard requirement: search engines reject FAQ markup whose
    text is not present on the page. This is what lets answer engines and
    AI assistants lift a clean question-and-answer pair instead of trying
    to parse it out of the accordion markup.
  */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  })} />

  <!-- ========================== HEADER ========================== -->
  <header class="legal-header">
    <div class="container legal-header-inner">
      <div class="legal-header-text">
        <p class="kicker reveal reveal-d1">
          <span class="kicker-dot" aria-hidden="true"></span>
          Frequently Asked
        </p>
        <h1 class="display legal-title reveal reveal-d2">
          Questions, <span class="display-italic">answered</span>.
        </h1>
        <p class="lede reveal reveal-d3">
          Most clients come to mediation with questions, uncertainty, and a
          desire for resolution without unnecessary conflict. Below are
          answers to the most important ones — so you can move forward with
          clarity, confidence, and control.
        </p>
      </div>

      <figure class="legal-header-figure reveal reveal-d2">
        <img
          src="/new_FAQ.jpg"
          alt="Portrait of Marie VanGinHoven"
          width="3974" height="6482"
          loading="eager"
          class="legal-header-img"
        />
      </figure>
    </div>
  </header>

  <!-- ========================== FAQ LIST ========================== -->
  <section class="faq-body">
    <div class="container-narrow">
      <ol class="faq-list" role="list">
        {faqs.map((item, idx) => (
          <li class="faq-item">
            <details class="faq-details">
              <summary class="faq-summary">
                <span class="faq-num display" aria-hidden="true">{String(idx + 1).padStart(2, "0")}</span>
                <span class="faq-question display">{item.q}</span>
                <span class="faq-toggle" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                    <path d="M3 8 H13 M8 3 V13" />
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========================== CLOSING CTA ========================== -->
  <section class="faq-close">
    <div class="container-narrow faq-close-inner">
      <a class="btn btn-primary faq-close-cta" href="/book">
        Book a Free, Private Consultation
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <p class="scheduling-note">Flexible Scheduling Available: Evening and Weekend Mediations to Accommodate Your Busy Life.</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     HEADER
     ============================================================ */
  .legal-header {
    position: relative;
    padding-block: clamp(4rem, 6vw + 1rem, 6rem) clamp(2rem, 3vw, 3rem);
    background:
      radial-gradient(ellipse at 80% 20%, rgba(196, 154, 75, 0.08), transparent 55%),
      var(--color-cream);
    border-bottom: 1px solid var(--color-divider);
    overflow: hidden;
  }
  /* Two-column header — text on the left, portrait on the right.
     Mirrors the /documents and /contact pages. */
  .legal-header-inner {
    position: relative;
    max-width: 64rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .legal-header-figure {
    margin: 0;
  }
  .legal-header-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2/3;
    object-fit: cover;
    object-position: center top;
    box-shadow:
      0 1px 2px rgba(18, 33, 74, 0.04),
      0 18px 40px -20px rgba(18, 33, 74, 0.2);
  }
  @media (max-width: 820px) {
    .legal-header-inner {
      grid-template-columns: 1fr;
    }
    .legal-header-figure {
      max-width: 20rem;
      margin-inline: auto;
      order: -1;
    }
  }
  .legal-title {
    margin-top: 1rem;
    font-size: var(--step-5);
    line-height: 1.02;
    color: var(--color-navy);
    letter-spacing: -0.025em;
    max-width: 22ch;
    font-weight: 400;
  }
  .legal-title .display-italic {
    color: var(--color-gold-deep);
    font-weight: 400;
  }
  .legal-header .lede {
    margin-top: 1.5rem;
    max-width: 60ch;
  }

  /* ============================================================
     FAQ LIST
     ============================================================ */
  .faq-body {
    padding-block: var(--space-2xl) var(--space-3xl);
    background: var(--color-cream);
  }

  .faq-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .faq-item {
    border-top: 1px solid var(--color-divider);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--color-divider);
  }

  .faq-details summary {
    list-style: none;
    cursor: pointer;
  }
  .faq-details summary::-webkit-details-marker { display: none; }

  .faq-summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.5rem 0.5rem 1.5rem 0;
    transition: color 0.25s, background 0.3s var(--ease-out);
  }
  .faq-details:hover .faq-summary {
    background: color-mix(in srgb, var(--color-cream-warm) 30%, transparent);
  }
  .faq-num {
    font-size: 1rem;
    color: var(--color-gold-deep);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1;
    font-variation-settings: "opsz" 24;
    align-self: center;
  }
  .faq-question {
    font-size: clamp(1.15rem, 0.95rem + 0.7vw, 1.45rem);
    color: var(--color-navy);
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .faq-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-gold-deep);
    border: 1px solid var(--color-divider);
    border-radius: 50%;
    background: var(--color-paper);
    transition: transform 0.4s var(--ease-out), background 0.25s, border-color 0.25s, color 0.25s;
    flex-shrink: 0;
    align-self: center;
  }
  .faq-details[open] .faq-toggle {
    transform: rotate(45deg);
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-cream);
  }

  .faq-answer {
    padding: 0 0.5rem 1.75rem clamp(2.5rem, 6vw, 4rem);
    font-family: var(--font-body);
    font-size: var(--step-1);
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: 64ch;
  }

  /* ============================================================
     CLOSING CTA
     ============================================================ */
  .faq-close {
    position: relative;
    padding-block: var(--space-lg);
    background:
      radial-gradient(ellipse at 80% 50%, rgba(196, 154, 75, 0.14), transparent 55%),
      radial-gradient(ellipse at 20% 80%, rgba(196, 154, 75, 0.08), transparent 45%),
      var(--color-cream-warm);
    color: var(--color-ink);
    overflow: hidden;
    border-top: 1px solid var(--color-divider);
  }
  .faq-close::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold) 40%, var(--color-gold) 60%, transparent);
    opacity: 0.7;
  }
  .faq-close-kicker { color: var(--color-gold-deep); }
  .faq-close-title {
    margin-block: 1rem 1.5rem;
    font-size: var(--step-4);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-navy);
    max-width: 22ch;
  }
  .faq-close-title .display-italic { color: var(--color-gold-deep); }
  .faq-close-lede {
    color: var(--color-ink-soft);
    max-width: 56ch;
  }
  .faq-close-inner { text-align: center; }
  .faq-close-cta {
    margin-top: 0;
    background: var(--color-navy);
    color: var(--color-cream);
    border-color: var(--color-navy);
  }
  .faq-close-cta:hover {
    background: var(--color-navy-deep);
    border-color: var(--color-gold);
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 600px) {
    .legal-title { font-size: clamp(2.25rem, 1.8rem + 3vw, 3.5rem); }
    .faq-summary {
      gap: 0.85rem;
      padding: 1.25rem 0;
    }
    .faq-num { font-size: 0.85rem; }
    .faq-toggle { width: 1.85rem; height: 1.85rem; }
    .faq-answer {
      padding-left: clamp(1.5rem, 5vw, 2.75rem);
      font-size: 1rem;
    }
  }
</style>
