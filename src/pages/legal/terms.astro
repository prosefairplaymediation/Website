---
import LegalLayout from "../../layouts/LegalLayout.astro";

const formats = [
  {
    label: "PDF",
    sublabel: "Portable Document · ~111 KB",
    href: "/Pro_Se_Fair_Play_Engagement_Agreement.pdf",
  },
  {
    label: "Docx",
    sublabel: "Microsoft Word · ~106 KB",
    href: "/Pro_Se_Fair_Play_Engagement_Agreement.docx",
  },
];
---

<LegalLayout
  pageTitle="Terms · Pro Se Fair Play Mediation"
  description="Engagement Agreement for Pro Se Fair Play Mediation & Document Preparation Services, LLC. Available for download as a Word document."
  title="Engagement"
  titleItalic="Agreement"
  lede="The Engagement Agreement governing services with Pro Se Fair Play Mediation LLC is provided as a downloadable Word document."
>
  <!-- ========================== DOWNLOAD CARDS ========================== -->
  <section class="legal-body">
    <div class="container-narrow">
      <h2 class="formats-label">Choose a format</h2>

      <div class="download-stack">
        {formats.map((f) => (
          <div class="download-card">
            <div class="download-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 5 H20 L26 11 V27 H8 Z" />
                <path d="M20 5 V11 H26" />
                <path d="M16 16 V23 M12 19 L16 23 L20 19" />
              </svg>
            </div>
            <div class="download-info">
              <p class="download-label smallcaps">{f.label}</p>
              <p class="download-sub">{f.sublabel}</p>
            </div>
            <a class="btn btn-primary download-btn" href={f.href} download>
              Download
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</LegalLayout>

<style>
  .formats-label {
    margin: 0 0 1.5rem;
    font-size: var(--step-1);
    color: var(--color-gold-deep);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    display: block;
  }
  .download-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .download-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding: clamp(2rem, 4vw, 3rem);
    background: var(--color-paper);
    border: 1px solid var(--color-divider);
    border-radius: 4px;
    position: relative;
    box-shadow:
      0 1px 2px rgba(18, 33, 74, 0.04),
      0 12px 32px -16px rgba(18, 33, 74, 0.18);
  }
  .download-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 4rem; height: 2px;
    background: var(--color-gold);
  }
  .download-icon {
    color: var(--color-gold-deep);
    display: grid;
    place-items: center;
    width: 4rem; height: 4rem;
  }
  .download-icon svg { width: 44px; height: 44px;
  }
  .download-info { min-width: 0;
  }
  .download-label {
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--color-navy);
    letter-spacing: -0.015em;
    line-height: 1.1;
    margin-bottom: 0.4rem;
    display: block;
    text-transform: none;
  }
  .download-sub {
    font-family: var(--font-body);
    font-size: var(--step-0);
    color: var(--color-slate);
    font-style: italic;
    line-height: 1.45;
  }
  .download-btn {
    white-space: nowrap;
    padding: 1.1rem 2rem;
    font-size: var(--step-0);
  }
  .download-card {
      grid-template-columns: 1fr;
      text-align: left;
  }
  .download-btn { justify-self: flex-start;
  }
</style>
