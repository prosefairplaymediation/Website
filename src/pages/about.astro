---
import BaseLayout from "../layouts/BaseLayout.astro";

const credentials = [
  { label: "Training", value: "Florida Supreme Court Certified Family Mediator" },
  { label: "Additional Certification", value: "Notary Public" },
  { label: "Practice", value: "Family Law · Pro Se Parties" },
  { label: "Format", value: "Zoom, Confidential" },
];
---

<BaseLayout
  title="About Marie · Pro Se Fair Play Mediation"
  description="Marie VanGinHoven, Florida Supreme Court Certified Family Mediator and founder of Pro Se Fair Play Mediation LLC, helps self-represented (pro se) parties prepare court-ready family law documents and navigate mediation."
>
  <!-- ========================== PROFILE HEADER ========================== -->
  <header class="profile-header">
    <div class="container profile-header-inner">
      <p class="kicker reveal reveal-d1">
        <span class="kicker-dot" aria-hidden="true"></span>
        About Me
      </p>
      <h1 class="display profile-name reveal reveal-d2">
        Marie <span class="display-italic">VanGinHoven</span>
      </h1>
      <p class="profile-tagline display display-italic reveal reveal-d3">
        A process you can trust. A space where you feel safe.
      </p>
    </div>
  </header>

  <!-- ========================== PROFILE BODY ========================== -->
  <section class="profile-body">
    <div class="container profile-grid">
      <figure class="profile-figure reveal reveal-d2">
        <div class="profile-figure-aura" aria-hidden="true"></div>
        <div class="profile-figure-frame">
          <img
            src="/new_Aboutme.jpg"
            alt="Portrait of Marie VanGinHoven"
            width="1970" height="3799"
            loading="eager"
            fetchpriority="high"
            class="profile-img"
          />
          <div class="profile-figure-warmth" aria-hidden="true"></div>
        </div>
        <figcaption class="profile-caption">
          <span class="profile-caption-line" aria-hidden="true"></span>
          <span class="smallcaps">Marie VanGinHoven</span>
          <span class="profile-caption-sub">Private Conflict Resolution Mediator</span>
        </figcaption>

        <dl class="profile-credentials">
          {credentials.map((c) => (
            <div class="cred">
              <dt class="cred-label smallcaps">{c.label}</dt>
              <dd class="cred-value">{c.value}</dd>
            </div>
          ))}
        </dl>
      </figure>

      <article class="profile-article reveal reveal-d3">
        <div class="profile-lead">
          <p class="profile-lead-line">Private Conflict Resolution Mediator</p>
          <p class="profile-lead-line">Specializing in High-Conflict Resolution</p>
          <p class="profile-lead-line">Private. Discreet. Strategic. Resolution-Focused.</p>
        </div>

        <p class="profile-p">
          I am the Founder and Private Conflict Resolution Mediator of
          Pro Se Fair Play Mediation, LLC, a boutique conflict-resolution
          practice created for individuals who want a more private,
          personalized, and productive way to resolve difficult disputes.
        </p>

        <p class="profile-p">
          I intentionally designed Pro Se Fair Play to be different from
          a traditional high-volume mediation practice. My approach
          combines professional preparation with something equally
          important: the ability to listen. I understand that behind
          every conflict are real people with real concerns,
          relationships, businesses, property, finances, and futures
          that matter.
        </p>

        <p class="profile-p">
          My style is compassionate yet structured, approachable yet
          professional, and always focused on moving the conversation
          toward productive resolution. With professional training in
          mediation and high-conflict resolution, I specialize in
          helping people navigate challenging circumstances where
          communication has broken down, emotions are elevated,
          positions have become entrenched, or the parties simply need
          a skilled neutral party to help move the conversation forward.
        </p>

        <p class="profile-p">
          I believe conflict resolution should be personal, accessible,
          discreet, and thoughtfully managed from beginning to end. My
          clients receive individualized attention, thoughtful
          preparation, flexible scheduling, and a professional
          environment designed around the circumstances of their
          particular dispute.
        </p>

        <p class="profile-p">
          Virtual appointments, evening availability, and weekend
          scheduling provide additional privacy and flexibility for
          busy professionals and individuals who need a resolution
          process that works around their lives, not the other way
          around.
        </p>

        <p class="profile-p">
          Not every disagreement needs to become a courtroom battle. At
          Pro Se Fair Play, my focus is not on winning an argument. I do
          not choose sides or decide who should prevail. My role is to
          provide the structure, neutrality, and conflict-resolution
          process necessary to help you work toward your own resolution.
        </p>

        <div class="profile-ctas">
          <a class="btn btn-primary" href="/book">
            Book a Free, Private Consultation
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <p class="scheduling-note scheduling-note--start">Flexible Scheduling Available: Evening and Weekend Mediations to Accommodate Your Busy Life.</p>
        </div>
      </article>
    </div>
  </section>

</BaseLayout>

<style>
  /* ============================================================
     PROFILE HEADER
     ============================================================ */
  .profile-header {
    position: relative;
    padding-block: clamp(4rem, 6vw + 2rem, 7rem) clamp(2rem, 3vw, 3.5rem);
    background:
      radial-gradient(ellipse at 20% 30%, rgba(196, 154, 75, 0.08), transparent 55%),
      var(--color-cream);
    overflow: hidden;
  }
  .profile-header::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, rgba(27, 45, 90, 0.035) 1px, transparent 1px);
    background-size: 7rem 100%;
    mask-image: linear-gradient(to bottom, black 0%, black 75%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 75%, transparent 100%);
    pointer-events: none;
  }
  .profile-header-inner { position: relative; }
  .profile-name {
    font-size: var(--step-5);
    line-height: 1.02;
    color: var(--color-navy);
    letter-spacing: -0.025em;
    margin-top: 1rem;
    max-width: 18ch;
    font-weight: 400;
  }
  .profile-name .display-italic {
    color: var(--color-gold-deep);
    font-weight: 300;
  }
  .profile-tagline {
    margin-top: 1.5rem;
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--color-navy);
    max-width: 32ch;
    font-weight: 400;
  }

  /* ============================================================
     PROFILE BODY — magazine layout
     ============================================================ */
  .profile-body {
    padding-block: var(--space-2xl) var(--space-3xl);
    background: var(--color-cream);
  }
  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  /* Figure */
  .profile-figure {
    position: sticky;
    top: 5.5rem;
    margin: 0;
  }
  /* Warm gold radial behind the frame — knits the cooler studio photo
     back into the cream/gold page palette. */
  .profile-figure-aura {
    position: absolute;
    inset: -2.5rem;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 35%,
        rgba(196, 154, 75, 0.28) 0%,
        rgba(196, 154, 75, 0.14) 30%,
        transparent 65%);
    filter: blur(8px);
  }
  .profile-figure-frame {
    position: relative;
    z-index: 1;
  }
  .profile-img {
    display: block;
    width: 100%;
    height: auto;
    /* Let the portrait display at its native aspect so the full figure
       (down to her shoes) is visible — the new photo is taller than 2/3. */
    /* Warm/desaturate the cool studio lighting so the portrait sits in
       the same tonal world as the cream/gold page. */
    filter: saturate(0.78) contrast(1.04) sepia(0.18) hue-rotate(-6deg);
    transition: filter 0.6s var(--ease-out);
    box-shadow:
      0 1px 2px rgba(18, 33, 74, 0.04),
      0 18px 40px -20px rgba(18, 33, 74, 0.2);
  }
  .profile-figure:hover .profile-img {
    filter: saturate(0.9) contrast(1.04) sepia(0.1) hue-rotate(-3deg);
  }
  /* Cream wash blended over the image — softens the cold blue server-room
     lights and pulls the photo toward the page palette. */
  .profile-figure-warmth {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 40%,
        transparent 0%,
        transparent 50%,
        rgba(250, 247, 240, 0.35) 100%),
      linear-gradient(180deg,
        rgba(196, 154, 75, 0.06) 0%,
        transparent 35%,
        rgba(250, 247, 240, 0.18) 100%);
    mix-blend-mode: multiply;
    z-index: 2;
  }

  .profile-caption {
    margin-top: 1.25rem;
    color: var(--color-slate);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1rem;
    position: relative;
  }
  .profile-caption-line {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 1px;
    background: var(--color-gold);
  }
  .profile-caption .smallcaps {
    color: var(--color-navy);
    font-size: 2.16rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.1;
  }
  .profile-caption-sub {
    font-family: var(--font-display);
    font-style: italic;
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 1.5rem;
    line-height: 1.25;
    color: var(--color-gold-deep);
  }

  /* Article */
  .profile-article {
    max-width: 60ch;
  }
  .profile-lead {
    margin-bottom: 1.5rem;
  }
  .profile-lead-line {
    font-family: var(--font-body);
    font-size: calc(var(--step-1) * 1.09);
    line-height: 1.4;
    color: var(--color-navy);
    font-weight: 700;
  }
  .profile-lead-line + .profile-lead-line { margin-top: 0.15rem; }
  .profile-p {
    font-family: var(--font-body);
    font-size: var(--step-1);
    line-height: 1.66;
    color: var(--color-ink-soft);
  }
  .profile-p + .profile-p { margin-top: 1.25rem; }
  .profile-p em {
    font-style: italic;
    font-family: var(--font-display);
  }

  /* Credentials — sits in the figure column under the photo caption */
  .profile-credentials {
    margin-top: 1.75rem;
    padding: 1.25rem 1.25rem 1.35rem;
    background: var(--color-cream-warm);
    border-top: 1px solid var(--color-gold);
    border-bottom: 1px solid var(--color-divider);
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }
  .cred {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem;
  }
  .cred-label {
    font-size: 0.66rem;
    color: var(--color-gold-deep);
    font-weight: 700;
    letter-spacing: 0.24em;
  }
  .cred-value {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24;
    font-size: 1.02rem;
    line-height: 1.3;
    color: var(--color-navy);
  }

  .profile-ctas {
    margin-top: var(--space-xl);
    display: flex;
    gap: 1.25rem;
    align-items: center;
    flex-wrap: wrap;
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 900px) {
    .profile-grid { grid-template-columns: 1fr; }
    .profile-figure { position: static; max-width: 26rem; margin-inline: auto; }
  }

  @media (max-width: 600px) {
    /* Long single words ("VanGinHoven", and oversized headings) overflow
       the viewport on phones at the default font-sizes. Tighten everything. */
    .profile-name {
      font-size: clamp(2.5rem, 1.6rem + 4vw, 4rem);
      max-width: 100%;
    }
    .profile-tagline {
      font-size: clamp(1.1rem, 0.9rem + 1.2vw, 1.5rem);
    }
    .profile-caption .smallcaps {
      font-size: clamp(1.4rem, 1.1rem + 2.8vw, 2.16rem);
      letter-spacing: 0.08em;
    }
    .profile-caption-sub {
      font-size: clamp(1.15rem, 0.95rem + 1.8vw, 1.5rem);
    }
    /* Safety net: any display heading wraps gracefully if needed */
    .display {
      overflow-wrap: break-word;
    }
  }
</style>
