---
import BaseLayout from "../layouts/BaseLayout.astro";

const email = "info@prosefairplaymediation.com";
const phoneDisplay = "(561) 941-0896";
const phoneTel = "+15619410896";
// eFax temporarily removed (number expired). Restore when renewed:
// const faxDigits = "561-652-9345";
---

<BaseLayout
  title="Contact · Pro Se Fair Play Mediation"
  description="Call and reach a live, U.S.-based concierge team days, evenings, and weekends. Real people ready to answer questions and help you schedule mediation. No voicemail."
>
  <!-- ========================== HEADER ========================== -->
  <header class="contact-header">
    <div class="container contact-header-inner">
      <div class="contact-header-text">
        <p class="kicker reveal reveal-d1">
          <span class="kicker-dot" aria-hidden="true"></span>
          Get in Touch
        </p>
        <h1 class="display contact-title reveal reveal-d2">
          Have a <span class="display-italic">question</span>?
        </h1>
        <p class="lede reveal reveal-d3">
          At Pro Se Fair Play Mediation, we believe that family matters
          don't just happen between 9:00 a.m. and 5:00 p.m. Life happens
          after hours, on weekends, and during some of the most stressful
          moments in a person's life.
        </p>
      </div>

      <figure class="contact-header-figure reveal reveal-d2">
        <img
          src="/New_Contact.jpg"
          alt="Portrait of Marie VanGinHoven"
          width="1067" height="1600"
          loading="eager"
          class="contact-header-img"
        />
      </figure>
    </div>
  </header>

  <!-- ========================== CONCIERGE ========================== -->
  <section class="contact-concierge">
    <div class="container-narrow concierge-prose">
      <p>
        That's why we've partnered with a live U.S.-based concierge
        answering service through Posh, ensuring that every client is
        greeted by a warm, professional person when they call our office.
      </p>

      <p class="concierge-lead-in">Our concierge team is trained to:</p>
      <ul class="concierge-list">
        <li>Welcome clients with compassion and professionalism.</li>
        <li>Answer questions about our mediation services.</li>
        <li>Guide clients through the booking process.</li>
        <li>Explain our pricing and services.</li>
        <li>Assist with scheduling consultations and mediations.</li>
        <li>Provide information about our evening and weekend availability.</li>
        <li>Ensure that no client ever feels like they're navigating the mediation process alone.</li>
      </ul>

      <p>No voicemail. No waiting days for a callback. Just real people providing real support.</p>

      <p>
        What truly sets Pro Se Fair Play Mediation apart is our commitment
        to accessibility. Whether a client reaches out during the day,
        after dinner, or on a Sunday afternoon, our concierge team is
        available to help connect them with the resources they need.
      </p>

      <p>This concierge experience reflects our mission:</p>
      <p class="concierge-mission">
        To make mediation approachable, convenient, and supportive from the
        very first phone call.
      </p>

      <p>
        At Pro Se Fair Play Mediation, we don't just offer mediation
        services. We provide a guided, white-glove client experience from
        beginning to end.
      </p>
    </div>
  </section>

  <!-- ========================== CONTACT CARDS ========================== -->
  <section class="contact-body">
    <div class="container-narrow contact-body-inner">
      <div class="contact-cards">
        <div class="contact-card">
          <p class="contact-label">Email</p>
          <a href={`mailto:${email}`} class="contact-value display">{email}</a>
        </div>

        <div class="contact-card">
          <p class="contact-label">Phone</p>
          <a
            href={`tel:${phoneTel}`}
            class="contact-value display"
            aria-label={`Call ${phoneDisplay}`}
          >{phoneDisplay}</a>
        </div>

        {/* eFax temporarily removed (number expired). Design kept for easy restore:
        <div class="contact-card">
          <p class="contact-label">eFax</p>
          <p class="contact-value display contact-value-static">{faxDigits}</p>
        </div>
        */}
      </div>

      <div class="contact-secondary">
        <a class="btn btn-primary contact-cta" href="/book">
          Book a Free, Private Consultation
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="scheduling-note scheduling-note--start">Flexible Scheduling Available: Evening and Weekend Mediations to Accommodate Your Busy Life.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     HEADER
     ============================================================ */
  .contact-header {
    position: relative;
    padding-block: clamp(4rem, 6vw + 1rem, 6rem) clamp(2rem, 3vw, 3rem);
    background:
      radial-gradient(ellipse at 80% 20%, rgba(196, 154, 75, 0.08), transparent 55%),
      var(--color-cream);
    border-bottom: 1px solid var(--color-divider);
    overflow: hidden;
  }
  .contact-header::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, rgba(27, 45, 90, 0.03) 1px, transparent 1px);
    background-size: 7rem 100%;
    mask-image: linear-gradient(to bottom, black 0%, black 75%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 75%, transparent 100%);
    pointer-events: none;
  }
  .contact-header-inner {
    position: relative;
    max-width: 64rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .contact-header-figure {
    margin: 0;
  }
  .contact-header-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2/3;
    object-fit: cover;
    object-position: center top;
    box-shadow:
      0 1px 2px rgba(18, 33, 74, 0.04),
      0 18px 40px -20px rgba(18, 33, 74, 0.2);
  }
  @media (max-width: 820px) {
    .contact-header-inner {
      grid-template-columns: 1fr;
    }
    .contact-header-figure {
      max-width: 20rem;
      margin-inline: auto;
      order: -1;
    }
  }
  .contact-title {
    font-size: var(--step-5);
    line-height: 1.02;
    color: var(--color-navy);
    margin-top: 1rem;
    letter-spacing: -0.025em;
    max-width: 22ch;
    font-weight: 400;
  }
  .contact-title .display-italic {
    color: var(--color-gold-deep);
    font-weight: 400;
  }
  .contact-header .lede {
    margin-top: 1.5rem;
    max-width: 56ch;
  }

  /* ============================================================
     CONCIERGE
     ============================================================ */
  .contact-concierge {
    padding-block: var(--space-xl) var(--space-lg);
    background: var(--color-cream);
  }
  .concierge-prose {
    font-family: var(--font-body);
    font-size: var(--step-1);
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .concierge-prose p { max-width: 64ch; }
  .concierge-prose p + p { margin-top: 1.25rem; }
  .concierge-lead-in { font-weight: 600; color: var(--color-navy); }
  .concierge-list {
    margin: 1rem 0 1.25rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 64ch;
  }
  .concierge-list li { line-height: 1.55; }
  .concierge-mission {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--color-navy);
    padding-left: 1rem;
    border-left: 2px solid var(--color-gold);
  }

  /* ============================================================
     CONTACT CARDS
     ============================================================ */
  .contact-body {
    padding-block: var(--space-lg) var(--space-3xl);
    background: var(--color-cream);
  }
  .contact-body-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .contact-card {
    padding: clamp(2rem, 4vw, 3rem);
    background: var(--color-paper);
    border: 1px solid var(--color-divider);
    border-radius: 4px;
    position: relative;
    box-shadow:
      0 1px 2px rgba(18, 33, 74, 0.04),
      0 12px 32px -16px rgba(18, 33, 74, 0.18);
  }
  .contact-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 4rem; height: 2px;
    background: var(--color-gold);
  }
  .contact-label {
    font-size: 1.2rem;
    color: var(--color-gold-deep);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: block;
  }
  .contact-value {
    display: block;
    font-size: clamp(1.5rem, 0.95rem + 2vw, 2.5rem);
    color: var(--color-navy);
    letter-spacing: -0.015em;
    line-height: 1.1;
    word-break: break-word;
    background-image: linear-gradient(var(--color-gold), var(--color-gold));
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: 0 100%;
    padding-bottom: 4px;
    transition: background-size 0.45s var(--ease-out), color 0.25s;
  }
  .contact-value:hover {
    background-size: 100% 2px;
    color: var(--color-navy-deep);
  }
  .contact-value-static {
    background-image: none;
    padding-bottom: 0;
  }
  .contact-value-static:hover {
    background-size: 0% 2px;
    color: var(--color-navy);
  }
  .contact-subnote {
    margin-top: 0.75rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    color: var(--color-slate);
    font-variant-numeric: tabular-nums;
  }

  /* ============================================================
     SECONDARY CTA
     ============================================================ */
  .contact-secondary {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-divider);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .secondary-label {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink-soft);
  }

  @media (max-width: 600px) {
    .contact-secondary {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
