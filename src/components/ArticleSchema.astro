---
/**
 * BlogPosting JSON-LD for a page under /process.
 *
 * One line per article page instead of a duplicated schema block in each,
 * and the dates come from src/lib/articles.ts so the index page and the
 * structured data can never disagree.
 *
 * Type is BlogPosting per client instruction. BlogPosting is a subtype of
 * Article, so every property below is still valid and nothing is lost;
 * search and answer engines treat the two the same for citation. Keep this
 * and the /process index in step: if one says BlogPosting and the other
 * says Article, the library describes itself two different ways.
 *
 * PENDING: author carries no certification claim. See the restore-point
 * comment in BaseLayout.astro before adding one.
 */
import { findArticle } from "../lib/articles.ts";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const article = findArticle(slug);
if (!article) {
  throw new Error(
    `ArticleSchema: no entry for slug "${slug}" in src/lib/articles.ts. ` +
      `Add it there so the /process index and this page stay in step.`
  );
}

const url = `https://prosefairplaymediation.com/process/${article.slug}`;
---

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description: article.blurb,
  url,
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  datePublished: article.published,
  dateModified: article.updated,
  author: {
    "@type": "Person",
    name: "Marie VanGinHoven",
    jobTitle: "High-Conflict Resolution Mediator",
    url: "https://prosefairplaymediation.com/about",
  },
  publisher: {
    "@type": "Organization",
    name: "Pro Se Fair Play Mediation LLC",
    url: "https://prosefairplaymediation.com",
    logo: {
      "@type": "ImageObject",
      url: "https://prosefairplaymediation.com/logo_BG_color_Cropped.png",
    },
  },
  isAccessibleForFree: true,
})} />
