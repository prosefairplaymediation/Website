---
// Reviews.astro — Google reviews, fetched at BUILD time and rendered as
// real HTML.
//
// Why this changed: the previous version rendered only an empty <div> and
// let Featurable's bundle.js inject the reviews in the browser. That works
// for people, but crawlers and AI answer engines largely do not execute
// third-party JS, so the served HTML contained no review text at all and
// the reviews contributed nothing to search or AI visibility.
//
// Now the reviews are fetched during `astro build` and baked into the
// output. Cloudflare rebuilds on every push, so the reviews refresh on
// each deploy rather than on each page view. That is the right trade for
// content that changes slowly, and it removes a render-blocking
// third-party script from the page.
//
// Deliberately NO Review/AggregateRating structured data. These are
// Google reviews, i.e. third-party reviews, and marking those up as our
// own review snippets is against Google's structured-data guidelines and
// risks a manual action. Showing the text is fine; claiming the rich
// result is not. The reviews still live on the Google Business Profile,
// which is where Google reads them from.
//
// If the fetch fails for any reason the component falls back to the
// original client-side widget, so a build can never break or ship an
// empty section.

import { getReviewData, getReviewUrl } from "../lib/reviews";

// `limit` trims the list for placements where reviews are supporting
// evidence rather than the point of the page (home, book). `showAllLink`
// adds a link through to /reviews, which carries the full set. `carousel`
// swaps the grid for a horizontal scroller — the cards stay real HTML
// either way, so nothing is hidden from crawlers.
interface Props {
  limit?: number;
  showAllLink?: boolean;
  carousel?: boolean;
}
const { limit, showAllLink = false, carousel = false } = Astro.props;

// Widget id is still needed here for the fallback markup below.
const WIDGET_ID = "837481b2-3b16-48ff-8ed0-a6dad2fe99f4";

const { reviews, average, ok } = await getReviewData();
const GOOGLE_REVIEW_URL = await getReviewUrl();

const usedFallback = !ok;
const total = reviews.length;
const shown = typeof limit === "number" ? reviews.slice(0, limit) : reviews;
const hasMore = showAllLink && total > shown.length;
---

<section class="reviews">
  <div class="container reviews-inner">
    {usedFallback ? (
      <!-- Fetch unavailable at build time: keep the original widget so the
           section still renders for visitors. -->
      <div class="reviews-widget">
        <div id={`featurable-${WIDGET_ID}`} data-featurable-async></div>
      </div>
      <script is:inline src="https://featurable.com/assets/bundle.js" defer charset="UTF-8"></script>
    ) : (
      <>
        <div class="reviews-head">
          <p class="kicker">
            <span class="kicker-dot" aria-hidden="true"></span>
            What Clients Say
          </p>
          <p class="reviews-meta">
            {average && <span class="reviews-avg">{average}</span>}
            <span class="reviews-stars" aria-hidden="true">★★★★★</span>
            <span class="reviews-count">
              {total} Google review{total === 1 ? "" : "s"}
            </span>
          </p>
        </div>

        <ul class={carousel ? "reviews-grid is-carousel" : "reviews-grid"} role="list">
          {shown.map((r) => (
            <li class="review-card">
              {typeof r.stars === "number" && (
                <p class="review-stars">
                  <span aria-hidden="true">{"★".repeat(r.stars)}</span>
                  <span class="sr-only">{r.stars} out of 5 stars</span>
                </p>
              )}
              <blockquote class="review-text">{r.text}</blockquote>
              <p class="review-name smallcaps">{r.name}</p>
            </li>
          ))}
        </ul>

        {carousel && (
          <p class="reviews-hint" aria-hidden="true">Scroll for more &rarr;</p>
        )}

        <p class="reviews-actions">
          {hasMore && (
            <a class="link-underline" href="/reviews">
              Read all {total} reviews
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          )}
          {GOOGLE_REVIEW_URL && (
            <a class="link-underline" href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener">
              Leave a review
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          )}
        </p>
      </>
    )}
  </div>
</section>

<style>
  .reviews {
    padding-block: var(--space-2xl);
    background: var(--color-cream);
    position: relative;
  }

  .reviews-head {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .reviews-meta {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 0.85rem;
    flex-wrap: wrap;
  }
  .reviews-avg {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--color-navy);
    line-height: 1;
  }
  .reviews-stars {
    color: var(--color-gold);
    letter-spacing: 0.1em;
    font-size: 1.05rem;
  }
  .reviews-count {
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: var(--color-slate);
  }

  .reviews-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-md);
  }

  .review-card {
    background: var(--color-paper);
    border: 1px solid var(--color-divider);
    border-radius: 3px;
    padding: 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    box-shadow: 0 1px 3px rgba(26, 28, 34, 0.04);
  }
  .review-stars {
    color: var(--color-gold);
    letter-spacing: 0.12em;
    font-size: 0.95rem;
    line-height: 1;
  }
  .review-text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  /* ---------- Carousel variant ----------
     Same markup and same real HTML as the grid; only the axis changes.
     Cards get a fixed width so they read as a track rather than stretching,
     and scroll-snap makes a swipe land cleanly on a card. */
  .reviews-grid.is-carousel {
    grid-template-columns: none;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.25rem;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    padding-bottom: 0.85rem;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-gold) 55%, transparent) transparent;
  }
  .reviews-grid.is-carousel > .review-card {
    flex: 0 0 clamp(16rem, 78vw, 21rem);
    scroll-snap-align: start;
  }
  /* Reviews vary wildly in length. Cap the visible height in the carousel so
     one very long review can't set the track height for everything else. The
     full text stays in the DOM — this is a visual clamp, not a truncation —
     and /reviews shows all of it unclamped. */
  .reviews-grid.is-carousel .review-text {
    display: -webkit-box;
    -webkit-line-clamp: 9;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .reviews-grid.is-carousel::-webkit-scrollbar { height: 6px; }
  .reviews-grid.is-carousel::-webkit-scrollbar-track { background: transparent; }
  .reviews-grid.is-carousel::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--color-gold) 55%, transparent);
    border-radius: 999px;
  }

  .reviews-hint {
    margin-top: 0.35rem;
    text-align: right;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-style: italic;
    letter-spacing: 0.04em;
    color: var(--color-slate);
  }

  .reviews-actions {
    margin-top: var(--space-md);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  .reviews-actions:empty { display: none; }

  .review-name {
    /* auto top margin pins attribution to the bottom of the card, so names
       line up across a row even though reviews differ in length. */
    margin: auto 0 0;
    padding-top: 0.35rem;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    color: var(--color-gold-deep);
  }

  /* Fallback widget: strip Featurable's white container backgrounds so it
     blends onto our cream section. Scoped under .reviews; :global() because
     that DOM is injected at runtime. */
  .reviews :global(.parent),
  .reviews :global(.widget),
  .reviews :global(.widget__container),
  .reviews :global(.widget__body),
  .reviews :global(.slider),
  .reviews :global(.slider--mobile) {
    background: transparent !important;
  }
</style>
