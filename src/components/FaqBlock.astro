---
/**
 * A visible question-and-answer section that also emits the matching
 * FAQPage structured data, both generated from one array.
 *
 * The single source is the point. Search engines and answer engines reject
 * — or worse, quietly distrust — FAQ markup whose text is not present on the
 * page, and the usual way that happens is a hand-written JSON-LD block that
 * drifts from the copy above it over a few edits. Here it cannot drift,
 * because there is only one copy of the text.
 *
 * On the value of this markup in 2026: Google retired FAQ rich results for
 * ordinary business sites in 2023, so this will not produce an expanded blue
 * link. It is still read by Bing and by the AI answer engines, which is where
 * the traffic worth having now comes from, and the visible accordion earns its
 * place regardless of what any crawler does with it.
 */
import { pageFaqs, type Faq } from "../lib/pageFaqs";

interface Props {
  /** Key into `pageFaqs`. */
  set: string;
  heading?: string;
}

const { set, heading = "Questions about this service" } = Astro.props;
const items: Faq[] = pageFaqs[set] ?? [];
if (!items.length) {
  throw new Error(`FaqBlock: no questions defined for set "${set}" in src/lib/pageFaqs.ts`);
}
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: items.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  })}
/>

<section class="pfaq" aria-labelledby={`pfaq-${set}`}>
  <div class="container-narrow">
    <h2 class="display pfaq-title" id={`pfaq-${set}`}>{heading}</h2>
    <ul class="pfaq-list">
      {items.map((f) => (
        <li class="pfaq-item">
          <details class="pfaq-details">
            <summary class="pfaq-summary">
              <span class="pfaq-question">{f.q}</span>
              <span class="pfaq-toggle" aria-hidden="true"></span>
            </summary>
            <p class="pfaq-answer">{f.a}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Deliberately mirrors the accordion on /faq and the section heading in
     InlineScheduler, which sits directly beneath this block on every page
     that uses it. Same borders, same hover wash, same circular toggle, same
     type scale -- a reader scrolling from one to the other should not be able
     to tell they were built at different times. */
  .pfaq {
    padding-block: var(--space-2xl);
    background: var(--color-paper);
    border-top: 1px solid var(--color-divider);
  }
  .pfaq-title {
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    color: var(--color-navy);
    margin: 0 0 var(--space-lg);
    letter-spacing: -0.015em;
    font-weight: 400;
  }
  .pfaq-list { list-style: none; margin: 0; padding: 0; }
  .pfaq-item { border-top: 1px solid var(--color-divider); }
  .pfaq-item:last-child { border-bottom: 1px solid var(--color-divider); }

  .pfaq-details summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.5rem 0.5rem 1.5rem 0;
    transition: color 0.25s, background 0.3s var(--ease-out);
  }
  .pfaq-details summary::-webkit-details-marker { display: none; }
  .pfaq-details:hover .pfaq-summary {
    background: color-mix(in srgb, var(--color-cream-warm) 30%, transparent);
  }
  .pfaq-details summary:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
  .pfaq-question {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24;
    font-size: clamp(1.15rem, 0.95rem + 0.7vw, 1.45rem);
    color: var(--color-navy);
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  .pfaq-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    color: var(--color-gold-deep);
    border: 1px solid var(--color-divider);
    border-radius: 50%;
    background: var(--color-paper);
    transition: transform 0.4s var(--ease-out), background 0.25s, border-color 0.25s;
  }
  /* Plus sign drawn in CSS: no icon font, no extra request. */
  .pfaq-toggle::before,
  .pfaq-toggle::after {
    content: "";
    position: absolute;
    width: 0.7rem;
    height: 1px;
    background: currentColor;
  }
  .pfaq-toggle::after { transform: rotate(90deg); }
  .pfaq-details[open] .pfaq-toggle {
    transform: rotate(45deg);
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-cream);
  }

  .pfaq-answer {
    margin: 0;
    padding: 0 0.5rem 1.75rem 0;
    font-family: var(--font-body);
    font-size: var(--step-1);
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: 64ch;
  }

  @media (max-width: 600px) {
    .pfaq-toggle { width: 1.85rem; height: 1.85rem; }
    .pfaq-answer { font-size: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pfaq-toggle { transition: none; }
  }
</style>
