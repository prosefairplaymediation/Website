---
import pkg from "../../package.json";
import { getReviewUrl } from "../lib/reviews";
import { PHONE_DISPLAY, TEL_HREF, SMS_HREF } from "../consts.ts";
const GOOGLE_REVIEW_URL = await getReviewUrl();
const year = new Date().getFullYear();
const version = pkg.version;
---

<footer class="footer">
  <div class="container footer-inner">
    {/*
      No slogan and no company name here. Both sit in the nav at the top of
      every page, and repeating them at the foot of the same screen read as
      padding rather than as branding. The company name is still stated in
      full in the copyright line below, which is where it is actually needed.
    */}
    <div class="footer-top">
      <nav class="footer-nav" aria-label="Footer">
        <div>
          <h3>Learn</h3>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/process/how-mediation-works">How Mediation Works</a></li>
            <li><a href="/process/pre-litigation-disputes">Pre-Litigation Disputes</a></li>
            <li><a href="/areas-served">Areas Served</a></li>
            <li><a href="/reviews">Client Reviews</a></li>
            {GOOGLE_REVIEW_URL && (
              <li>
                <a href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener">Click here to leave a review</a>
              </li>
            )}
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h3>Legal</h3>
          <ul>
            <li><a href="/cancellation">Cancellation</a></li>
            <li><a href="/refund">Refunds</a></li>
            <li><a href="/legal/disclaimer">Disclaimer</a></li>
            <li><a href="/legal/terms">Agreement</a></li>
            <li><a href="/legal/privacy">Privacy</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <hr class="rule" />

    {/*
      The contact line. It sat stacked under the slogan in the brand column
      until 2026-09-02, which put a phone number, an email and a gold button in
      the middle of the page competing with the slogan above them. Here it is
      one line across the foot of the site: details on the left, the booking
      button opposite, the copyright beneath. Nothing is centred, and the eye
      lands on the phone number rather than on a stack of four things.
    */}
    <div class="footer-contactbar">
      <address class="footer-contact">
        <a href={TEL_HREF} class="footer-phone">{PHONE_DISPLAY}</a>
        {/* Call and text sit together because the line is a mobile and takes
            both. Tapping the number still calls, which is what a phone number
            is expected to do; Text is its own target so neither is guessed at. */}
        <a href={SMS_HREF} class="footer-text-link">Text me</a>
        <span class="footer-sep" aria-hidden="true">&middot;</span>
        <a href="mailto:info@prosefairplaymediation.com" class="footer-email">info@prosefairplaymediation.com</a>
        <span class="footer-sep" aria-hidden="true">&middot;</span>
        <span class="footer-where">West Palm Beach, Florida &mdash; serving all Florida by Zoom</span>
      </address>

      <a href="/book" class="footer-cta">Book a free consultation</a>
    </div>

    {/* The caution belongs next to the invitation, not on a policy page
        nobody opens. A text message is not a confidential channel, and this
        site is careful to say so everywhere else it invites contact. */}
    <p class="footer-textnote">
      Calls and texts both reach Marie directly. Texts are not a confidential
      channel &mdash; please keep details of your situation out of them.
    </p>

    <div class="footer-bottom">
      <p class="copy">
        © {year} Pro Se Fair Play Mediation LLC. All rights reserved.
        <span class="build-version" aria-label="Site build version">v{version}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy-deep);
    color: var(--color-cream);
    position: relative;
    overflow: hidden;
  }
  .footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold) 30%, var(--color-gold) 70%, transparent);
    opacity: 0.55;
  }
  .footer-inner {
    /* The extra bottom padding clears the two floating widgets. The music
       player is pinned to the bottom-left of the viewport and the chat launcher
       to the bottom-right, so when someone reaches the end of the page both
       corners are occupied and the last line of text sits underneath one of
       them whichever way it is aligned. Height, not alignment, is the fix. */
    padding-block: var(--space-2xl) calc(var(--space-lg) + 4rem);
  }
  /* The telephone number was present in the schema but nowhere a visitor could
     see it: 31 of 35 pages offered no way to call. This puts it, the email and
     a booking link on every page — now as one line at the foot rather than a
     stack in the middle of the brand column. */
  .footer-contactbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-lg);
    padding-bottom: var(--space-md);
  }
  .footer-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    /* Row gap larger than column gap: when this wraps on a narrow screen the
       lines need to separate more than the items within a line do. */
    gap: 0.5rem 0.9rem;
    margin: 0;
    font-style: normal;
    line-height: 1.4;
  }
  .footer-contact a {
    color: var(--color-cream);
    text-decoration: none;
    /* Underline drawn as a border so it can be tinted independently of the
       text and animated to gold on hover. */
    border-bottom: 1px solid color-mix(in srgb, var(--color-cream) 25%, transparent);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .footer-contact a:hover {
    color: var(--color-gold);
    border-bottom-color: var(--color-gold);
  }
  .footer-contact a:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
    border-radius: 1px;
  }
  /* The number is the one thing here worth reading first, so it gets the
     display face and a step above everything beside it. */
  .footer-phone {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: 0.02em;
  }
  .footer-email {
    font-size: var(--step-sm);
  }
  /* Gold rather than cream, and a shade smaller than the number beside it: it
     is a second action on the same line, not a competing one. */
  .footer-text-link {
    font-size: var(--step-sm);
    color: var(--color-gold);
    letter-spacing: 0.06em;
  }
  .footer-sep {
    color: var(--color-gold);
    opacity: 0.5;
    font-size: var(--step-sm);
  }
  .footer-where {
    font-size: var(--step-xs);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-cream) 62%, var(--color-navy));
  }
  .footer-textnote {
    margin: 0 0 var(--space-lg);
    max-width: 62ch;
    font-size: var(--step-xs);
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-cream) 55%, var(--color-navy));
  }
  .footer-cta {
    display: inline-block;
    flex-shrink: 0;
    padding: 0.72rem 1.5rem;
    background: var(--color-gold);
    color: var(--color-navy-deep);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: var(--step-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 2px;
    transition: filter 0.15s ease, transform 0.15s ease;
  }
  .footer-cta:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }
  .footer-cta:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 3px;
  }
  .footer-top {
    margin-bottom: var(--space-xl);
  }

  .footer-nav {
    display: grid;
    /* Learn holds twelve links in two sub-columns, Legal five in one, so the
       row is split to match rather than into equal halves. */
    grid-template-columns: 2fr 1fr;
    gap: var(--space-2xl);
  }
  /* Learn carries twelve links and Legal five, so a single column left the
     footer twice as tall as it needed to be — and once the contact block moved
     out of the brand column, that height showed as a large empty panel beside
     the slogan. Two columns halve it and the void closes. */
  .footer-nav > div:first-child ul {
    /* display:block is load-bearing: the base rule sets the list to flex, and
       a flex container ignores `columns` entirely. */
    display: block;
    columns: 2;
    column-gap: var(--space-md);
  }
  .footer-nav > div:first-child li {
    break-inside: avoid;
  }
  .footer-nav h3 {
    font-family: var(--font-body);
    font-size: var(--step-sm);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }
  /* Gap converted into padding on the link itself. These were 17px tall
     touch targets, under the 24px WCAG 2.5.8 minimum, and fiddly on a phone.
     Moving the same vertical space inside the anchor grows the tappable box
     to ~30px without changing the footer's height or its visual rhythm:
     adjacent targets now meet exactly, so there is no dead strip between
     them either. inline-block rather than block so the target tracks the
     text width instead of the whole column. */
  .footer-nav ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0; }
  .footer-nav a {
    color: color-mix(in srgb, var(--color-cream) 80%, var(--color-navy));
    font-size: var(--step-sm);
    position: relative;
    transition: color 0.2s;
    display: inline-block;
    padding-block: 0.45rem;
  }
  .footer-nav a:hover { color: var(--color-gold); }

  .rule {
    background: color-mix(in srgb, var(--color-gold) 35%, transparent);
    margin-block: var(--space-lg);
  }

  .footer-bottom {
    display: flex;
    /* Left, not right. The chat widget is fixed to the bottom-right corner, so
       anything right-aligned on the last line of the page sits underneath it —
       the build version was disappearing behind Marie's face. */
    justify-content: flex-start;
    /* A hairline rather than a second gold rule: the contact line above is the
       one that should carry weight down here, and two rules of equal strength
       would read as a table. */
    border-top: 1px solid color-mix(in srgb, var(--color-cream) 10%, transparent);
    padding-top: var(--space-md);
  }
  .copy {
    font-size: var(--step-2xs);
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-cream) 55%, var(--color-navy));
    text-align: left;
    /* One line rather than a stack: the year and the build tag are the same
       kind of small print and read better beside each other. */
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
  }
  .build-version {
    font-family: var(--font-body);
    font-size: var(--step-2xs);
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--color-cream) 28%, var(--color-navy-deep));
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-cta { transition: none; }
    .footer-cta:hover { transform: none; }
  }

  @media (max-width: 780px) {
    /* space-between stops earning its keep once this wraps — it strands the
       button against the right edge under a ragged line of text. Stacked and
       left-aligned reads as one block instead. */
    .footer-contactbar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
    /* Two even columns on a phone, and Learn drops its sub-columns: three
       narrow columns of link text is unreadable at this width. */
    .footer-nav { grid-template-columns: repeat(2, 1fr); gap: var(--space-md); }
    .footer-nav > div:first-child ul { columns: 1; }
    /* Right (Legal) column hugs the right edge. */
    .footer-nav > div:last-child { text-align: right; }
  }
</style>
