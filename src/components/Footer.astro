---
import pkg from "../../package.json";
import { getReviewUrl } from "../lib/reviews";
const GOOGLE_REVIEW_URL = await getReviewUrl();
const year = new Date().getFullYear();
const version = pkg.version;
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <h2 class="footer-motto display display-italic">Where we level the playing field.</h2>
        <p class="footer-name smallcaps">Pro Se Fair Play Mediation LLC</p>

        <address class="footer-contact">
          <a href="tel:+15619410896" class="footer-phone">561-941-0896</a>
          <a href="mailto:info@prosefairplaymediation.com">info@prosefairplaymediation.com</a>
          <span class="footer-where">West Palm Beach, Florida &middot; serving all Florida by Zoom</span>
        </address>

        <a href="/book" class="footer-cta">Book a free consultation</a>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <div>
          <h4>Learn</h4>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/process/how-mediation-works">How Mediation Works</a></li>
            <li><a href="/process/child-support-rules">Updated Child Support Rules</a></li>
            <li><a href="/process/alimony-rules">Updated Alimony Rules</a></li>
            <li><a href="/process/real-estate-mediation">Real Estate Mediation</a></li>
            <li><a href="/process/pre-litigation-disputes">Pre-Litigation Disputes</a></li>
            <li><a href="/process/is-mediation-required-before-divorce-in-florida">Is Mediation Required in Florida?</a></li>
            <li><a href="/process/pro-se-divorce-florida">Filing Without a Lawyer</a></li>
            <li><a href="/areas-served">Areas Served</a></li>
            <li><a href="/reviews">Client Reviews</a></li>
            {GOOGLE_REVIEW_URL && (
              <li>
                <a href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener">Click here to leave a review</a>
              </li>
            )}
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div>
          <h4>Legal</h4>
          <ul>
            <li><a href="/legal/disclaimer">Disclaimer</a></li>
            <li><a href="/legal/terms">Agreement</a></li>
            <li><a href="/legal/privacy">Privacy</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <hr class="rule" />

    <div class="footer-bottom">
      <p class="copy">
        © {year} Pro Se Fair Play Mediation LLC. All rights reserved.
        <span class="build-version" aria-label="Site build version">v{version}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-navy-deep);
    color: var(--color-cream);
    position: relative;
    overflow: hidden;
  }
  .footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold) 30%, var(--color-gold) 70%, transparent);
    opacity: 0.55;
  }
  .footer-inner {
    padding-block: var(--space-2xl) var(--space-lg);
  }
  /* The telephone number was present in the schema but nowhere a visitor could
     see it: 31 of 35 pages offered no way to call. This puts it, the email and
     a booking link on every page. */
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: var(--space-sm);
    font-style: normal;
    line-height: 1.5;
  }
  .footer-contact a {
    color: var(--color-cream);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    align-self: flex-start;
  }
  .footer-contact a:hover {
    border-bottom-color: var(--color-gold);
  }
  .footer-phone {
    font-size: 1.15rem;
    letter-spacing: 0.02em;
  }
  .footer-where {
    font-size: 0.85rem;
    opacity: 0.75;
    margin-top: 0.15rem;
  }
  .footer-cta {
    display: inline-block;
    align-self: flex-start;
    margin-top: var(--space-md);
    padding: 0.7rem 1.35rem;
    background: var(--color-gold);
    color: var(--color-navy-deep);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.03em;
    border-radius: 2px;
    transition: filter 0.15s ease;
  }
  .footer-cta:hover {
    filter: brightness(1.08);
  }
  .footer-cta:focus-visible {
    outline: 2px solid var(--color-cream);
    outline-offset: 3px;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-xl);
  }
  .footer-motto {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-cream);
    max-width: 20ch;
  }
  .footer-name {
    margin-top: 1.25rem;
    color: var(--color-gold);
    font-size: 0.82rem;
    letter-spacing: 0.24em;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  .footer-nav h4 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }
  /* Gap converted into padding on the link itself. These were 17px tall
     touch targets, under the 24px WCAG 2.5.8 minimum, and fiddly on a phone.
     Moving the same vertical space inside the anchor grows the tappable box
     to ~30px without changing the footer's height or its visual rhythm:
     adjacent targets now meet exactly, so there is no dead strip between
     them either. inline-block rather than block so the target tracks the
     text width instead of the whole column. */
  .footer-nav ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0; }
  .footer-nav a {
    color: color-mix(in srgb, var(--color-cream) 80%, var(--color-navy));
    font-size: 0.95rem;
    position: relative;
    transition: color 0.2s;
    display: inline-block;
    padding-block: 0.45rem;
  }
  .footer-nav a:hover { color: var(--color-gold); }

  .rule {
    background: color-mix(in srgb, var(--color-gold) 35%, transparent);
    margin-block: var(--space-lg);
  }

  .footer-bottom {
    display: flex;
    justify-content: flex-end;
  }
  .copy {
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-cream) 55%, var(--color-navy));
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: flex-end;
  }
  .build-version {
    font-family: var(--font-body);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--color-cream) 28%, var(--color-navy-deep));
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 780px) {
    .footer-top { grid-template-columns: 1fr; gap: var(--space-xl); }
    .footer-bottom { justify-content: flex-start; }
    .copy { text-align: left; align-items: flex-start; }
    .footer-nav { grid-template-columns: repeat(2, 1fr); }
    /* Keep the slogan on one line: drop the width cap and scale the font
       to fit the phone width. */
    .footer-motto {
      max-width: none;
      white-space: nowrap;
      font-size: clamp(1.2rem, 5.1vw, 1.7rem);
    }
    /* Right (Legal) column hugs the right edge. */
    .footer-nav > div:last-child { text-align: right; }
  }
</style>
