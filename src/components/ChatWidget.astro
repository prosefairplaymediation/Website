---
// Floating "ask a question" widget, bottom-right on every page.
//
// It answers from /faq and nothing else. Matching is done client-side against
// the questions and their keyword lists, and the reply is the FAQ answer
// verbatim. There is deliberately no language model behind it: an improvising
// bot on a mediation site can be asked what someone should do in their own
// case and will answer, which is exactly what /legal/disclaimer says this
// practice does not do. A retrieval bot cannot make that mistake.
//
// Labelled as automated, per client decision. Do not quietly remove that
// labelling: a widget with Marie's face that texts like Marie invites the
// belief that a visitor is talking to their mediator in confidence, and
// someone will type case details into it.
//
// The answers are fetched from /chat-faq.json on first open, so pages carry
// the widget but not 15 KB of FAQ text. Bottom-right; the music player sits
// bottom-left, so they do not collide.
---

<aside class="cw" data-chat>
  <div class="cw-teaser" data-teaser role="status" aria-live="polite">
    <button class="cw-teaser-x" data-teaser-close type="button" aria-label="Dismiss">&times;</button>
    <b>Hi, I&rsquo;m Marie.</b>
    Have a question about mediation? Ask me here.
  </div>

  <button class="cw-launch" data-launch type="button" aria-label="Ask a question" aria-expanded="false">
    <img src="/marie-chat.jpg" width="60" height="60" alt="Marie VanGinHoven" />
    <span class="cw-badge" aria-hidden="true"></span>
  </button>

  <div class="cw-panel" data-panel role="dialog" aria-label="Ask a question" aria-modal="false">
    <div class="cw-head">
      <img src="/marie-chat.jpg" width="40" height="40" alt="" />
      <div class="cw-head-txt">
        <span class="cw-head-name">Marie VanGinHoven</span>
        <span class="cw-head-sub">Automated answers &middot; not live chat</span>
      </div>
      <button class="cw-x" data-close type="button" aria-label="Close">&times;</button>
    </div>

    <p class="cw-note">
      <strong>Automated assistant.</strong> Answers come from the
      <a href="/faq">FAQ</a>. Please don&rsquo;t share details of your case here.
    </p>

    <div class="cw-log" data-log></div>
    <div class="cw-chips" data-chips></div>

    <form class="cw-form" data-form autocomplete="off">
      <input data-input type="text" placeholder="Ask a question…" aria-label="Your question" />
      <button type="submit" aria-label="Send">&rarr;</button>
    </form>
  </div>
</aside>

<style>
  .cw { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 60; transition: bottom 0.25s var(--ease-out, ease); }
  /* Lifted clear of the mobile sticky booking bar while it is showing. */
  @media (max-width: 860px) {
    :global(html.has-scta) .cw { bottom: calc(1.25rem + 68px); }
  }
  @media (prefers-reduced-motion: reduce) { .cw { transition: none; } }

  .cw-launch {
    position: relative; padding: 0; border: 0; background: transparent; cursor: pointer;
    opacity: 0; animation: rise-in 0.9s var(--ease-out) 0.8s forwards;
  }
  .cw-launch img {
    width: 60px; height: 60px; border-radius: 50%; display: block;
    border: 2px solid var(--color-gold);
    box-shadow: 0 8px 24px rgba(18, 33, 74, 0.3);
    background: var(--color-cream);
  }
  .cw-launch:focus-visible { outline: 3px solid var(--color-gold); outline-offset: 4px; border-radius: 50%; }
  .cw-badge {
    position: absolute; top: -2px; right: -2px; width: 15px; height: 15px;
    border-radius: 50%; background: var(--color-gold); border: 2px solid var(--color-cream);
  }

  .cw-teaser {
    position: absolute; right: 0; bottom: 74px; width: 250px;
    background: var(--color-paper); border: 1px solid var(--color-divider);
    border-radius: 12px 12px 4px 12px;
    padding: 0.85rem 2rem 0.85rem 0.95rem;
    box-shadow: 0 12px 32px rgba(18, 33, 74, 0.18);
    font-family: var(--font-body); font-size: var(--step-sm); line-height: 1.45;
    color: var(--color-ink-soft); cursor: pointer;
    opacity: 0; transform: translateY(6px); pointer-events: none;
    transition: opacity 0.45s var(--ease-out), transform 0.45s var(--ease-out);
  }
  .cw-teaser.is-on { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .cw-teaser b {
    display: block; font-family: var(--font-display); font-weight: 400;
    color: var(--color-navy);
  }
  .cw-teaser-x {
    position: absolute; top: 4px; right: 6px; border: 0; background: transparent;
    color: var(--color-slate); cursor: pointer; font-size: var(--step-1); line-height: 1; padding: 4px 6px;
  }
  .cw-teaser-x:hover { color: var(--color-navy); }

  .cw-panel {
    position: absolute; right: 0; bottom: 0;
    width: 352px; height: 470px;
    max-width: calc(100vw - 2.5rem); max-height: calc(100dvh - 6rem);
    display: none; flex-direction: column; overflow: hidden;
    background: var(--color-cream);
    border: 1px solid var(--color-divider); border-radius: 12px;
    box-shadow: 0 24px 60px rgba(18, 33, 74, 0.3);
  }
  .cw-panel.is-on { display: flex; }

  .cw-head {
    background: var(--color-navy-deep); padding: 0.8rem 0.9rem;
    display: flex; align-items: center; gap: 0.65rem;
  }
  .cw-head img { width: 40px; height: 40px; border-radius: 50%; border: 1.5px solid var(--color-gold); display: block; }
  .cw-head-txt { min-width: 0; display: flex; flex-direction: column; }
  .cw-head-name { font-family: var(--font-display); color: var(--color-cream); font-size: var(--step-sm); line-height: 1.2; }
  .cw-head-sub { font-family: var(--font-body); color: #B9C0D6; font-size: var(--step-2xs); letter-spacing: 0.03em; }
  .cw-x {
    margin-left: auto; background: transparent; border: 0; color: #B9C0D6;
    font-size: var(--step-2); line-height: 1; cursor: pointer; padding: 4px 6px;
  }
  .cw-x:hover { color: var(--color-gold); }

  .cw-note {
    margin: 0; background: var(--color-cream-warm);
    border-bottom: 1px solid var(--color-divider);
    padding: 0.5rem 0.9rem; font-family: var(--font-body);
    font-size: var(--step-2xs); line-height: 1.4; color: var(--color-slate);
  }
  .cw-note strong { color: var(--color-gold-deep); }
  .cw-note a { color: var(--color-gold-deep); text-decoration: underline; }

  .cw-log { flex: 1; overflow-y: auto; padding: 0.9rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .cw-log :global(.cw-msg) {
    max-width: 84%; font-family: var(--font-body);
    font-size: var(--step-sm); line-height: 1.5; padding: 0.6rem 0.8rem;
  }
  .cw-log :global(.cw-msg.is-bot) {
    align-self: flex-start; background: var(--color-paper); color: var(--color-ink-soft);
    border: 1px solid var(--color-divider); border-radius: 12px 12px 12px 3px;
  }
  .cw-log :global(.cw-msg.is-me) {
    align-self: flex-end; background: var(--color-navy); color: var(--color-cream);
    border-radius: 12px 12px 3px 12px;
  }
  .cw-log :global(.cw-cta) {
    display: inline-block; margin-top: 0.5rem;
    background: var(--color-navy); color: var(--color-cream); text-decoration: none;
    font-size: var(--step-xs); font-weight: 600; padding: 0.42rem 0.8rem; border-radius: 2px;
  }
  .cw-log :global(.cw-cta:hover) { background: var(--color-navy-deep); }

  .cw-log :global(.cw-typing) { align-self: flex-start; display: flex; gap: 4px; padding: 0.7rem 0.85rem; }
  .cw-log :global(.cw-typing i) {
    width: 6px; height: 6px; border-radius: 50%; background: var(--color-gold);
    display: block; animation: cw-bob 1.1s infinite ease-in-out;
  }
  .cw-log :global(.cw-typing i:nth-child(2)) { animation-delay: 0.15s; }
  .cw-log :global(.cw-typing i:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes cw-bob {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.45; }
    40% { transform: translateY(-4px); opacity: 1; }
  }

  .cw-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0 0.9rem 0.6rem; }
  .cw-chips:empty { display: none; }
  .cw-chips :global(.cw-chip) {
    font-family: var(--font-body); font-size: var(--step-xs); line-height: 1.3; text-align: left;
    background: var(--color-paper); border: 1px solid var(--color-divider);
    color: var(--color-navy); border-radius: 999px; padding: 0.35rem 0.7rem; cursor: pointer;
  }
  .cw-chips :global(.cw-chip:hover) { border-color: var(--color-gold); color: var(--color-gold-deep); }
  .cw-chips :global(.cw-chip:focus-visible) { outline: 2px solid var(--color-gold); outline-offset: 2px; }

  .cw-form {
    display: flex; gap: 0.45rem; padding: 0.65rem 0.9rem 0.85rem;
    border-top: 1px solid var(--color-divider); background: var(--color-cream-warm);
  }
  .cw-form input {
    flex: 1; min-width: 0; font-family: var(--font-body); font-size: var(--step-sm);
    padding: 0.55rem 0.7rem; border: 1px solid var(--color-divider);
    border-radius: 999px; background: var(--color-paper); color: var(--color-ink);
  }
  .cw-form input:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 1px; }
  .cw-form button {
    border: 0; background: var(--color-navy); color: var(--color-cream);
    border-radius: 50%; width: 38px; height: 38px; flex: 0 0 38px;
    cursor: pointer; font-size: var(--step-0);
  }
  .cw-form button:hover { background: var(--color-navy-deep); }

  /* The open mobile nav covers the viewport; get out of its way, same as the
     music player does. */
  body:has(#nav-toggle[aria-expanded="true"]) .cw { visibility: hidden; pointer-events: none; }

  @media (max-width: 34rem) {
    .cw { right: 0.9rem; bottom: 0.9rem; }
    .cw-teaser { width: min(250px, calc(100vw - 3rem)); }
  }
</style>

<script is:inline>
  (function () {
    const root = document.querySelector("[data-chat]");
    if (!root) return;

    const panel = root.querySelector("[data-panel]");
    const launch = root.querySelector("[data-launch]");
    const teaser = root.querySelector("[data-teaser]");
    const log = root.querySelector("[data-log]");
    const chips = root.querySelector("[data-chips]");
    const form = root.querySelector("[data-form]");
    const input = root.querySelector("[data-input]");

    const STOP = new Set(("a an and are as at be but by can do does for from has have how i if in is it its me my"
      + " of on or our so that the their there they this to was we what when where which who will with you your am"
      + " not no dont get got would should could about into like just really very").split(" "));

    const norm = (s) => s.toLowerCase().replace(/[^a-z0-9\s']/g, " ").split(/\s+/).filter(Boolean);
    const words = (s) => norm(s).filter((w) => w.length > 2 && !STOP.has(w));
    const esc = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    let entries = null;
    let loading = null;

    function load() {
      if (entries) return Promise.resolve(entries);
      if (loading) return loading;
      loading = fetch("/chat-faq.json")
        .then((r) => r.json())
        .then((d) => {
          entries = [
            ...d.routes.map((r) => Object.assign({ kind: "route" }, r)),
            ...d.faq.map((f) => Object.assign({ kind: "faq" }, f)),
          ];
          return entries;
        })
        .catch(() => {
          entries = [];
          return entries;
        });
      return loading;
    }

    function score(query, entry) {
      const q = words(query);
      if (!q.length) return 0;
      const hay = new Set(words(entry.q).concat(norm(entry.keys || "")));
      let hits = 0;
      for (const w of q) {
        if (hay.has(w)) { hits += 1; continue; }
        for (const h of hay) {
          if (h.length > 4 && w.length > 4 && (h.startsWith(w.slice(0, 5)) || w.startsWith(h.slice(0, 5)))) {
            hits += 0.6;
            break;
          }
        }
      }
      return hits / q.length;
    }

    function bubble(who, html) {
      const d = document.createElement("div");
      d.className = "cw-msg " + who;
      d.innerHTML = html;
      log.appendChild(d);
      log.scrollTop = log.scrollHeight;
      return d;
    }

    // Land on the top of a new reply, so a long answer is read from its
    // first line instead of its last.
    function showFrom(el) {
      log.scrollTop += el.getBoundingClientRect().top - log.getBoundingClientRect().top - 8;
    }

    function setChips(list) {
      chips.innerHTML = "";
      list.forEach((q) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "cw-chip";
        b.textContent = q.length > 52 ? q.slice(0, 50) + "…" : q;
        b.addEventListener("click", function () { ask(q); });
        chips.appendChild(b);
      });
    }

    function ask(text) {
      bubble("is-me", esc(text));
      const t = document.createElement("div");
      t.className = "cw-typing";
      t.innerHTML = "<i></i><i></i><i></i>";
      log.appendChild(t);
      log.scrollTop = log.scrollHeight;

      load().then(function (list) {
        setTimeout(function () {
          t.remove();
          const ranked = list
            .map(function (e) { return { e: e, s: score(text, e) }; })
            .sort(function (a, b) { return b.s - a.s; });
          const top = ranked[0];

          if (!top || top.s < 0.34) {
            const near = ranked.filter(function (r) { return r.e.kind === "faq"; }).slice(0, 3);
            const b = bubble("is-bot",
              "I&rsquo;m not sure I have that one. I only answer from the FAQ, so rather than guess &mdash; "
              + "here are the closest questions, or you can reach Marie directly."
              + '<a class="cw-cta" href="/contact">Contact Marie</a>');
            setChips(near.map(function (r) { return r.e.q; }));
            showFrom(b);
            return;
          }

          let html = esc(top.e.a);
          if (top.e.kind === "route") {
            html += '<a class="cw-cta" href="' + top.e.href + '">' + esc(top.e.cta) + "</a>";
          }
          const b = bubble("is-bot", html);
          setChips(ranked
            .filter(function (r) { return r.e !== top.e && r.e.kind === "faq"; })
            .slice(0, 3)
            .map(function (r) { return r.e.q; }));
          showFrom(b);
        }, 560);
      });
    }

    function greet() {
      log.innerHTML = "";
      bubble("is-bot",
        "Hi, I&rsquo;m Marie. I can answer the questions I get asked most, straight from my FAQ. "
        + "What would you like to know?");
      load().then(function (list) {
        const faq = list.filter(function (e) { return e.kind === "faq"; });
        const route = list.filter(function (e) { return e.kind === "route"; });
        const pick = [faq[4], faq[6], route[0], faq[3]].filter(Boolean);
        setChips(pick.map(function (e) { return e.q; }));
      });
    }

    function open() {
      panel.classList.add("is-on");
      launch.style.display = "none";
      teaser.classList.remove("is-on");
      launch.setAttribute("aria-expanded", "true");
      if (!log.children.length) greet();
      setTimeout(function () { input.focus(); }, 60);
    }
    function close() {
      panel.classList.remove("is-on");
      launch.style.display = "";
      launch.setAttribute("aria-expanded", "false");
      launch.focus();
    }

    launch.addEventListener("click", open);
    root.querySelector("[data-close]").addEventListener("click", close);
    root.querySelector("[data-teaser-close]").addEventListener("click", function (e) {
      e.stopPropagation();
      teaser.classList.remove("is-on");
      try { sessionStorage.setItem("psfp-chat-teaser", "off"); } catch (err) {}
    });
    teaser.addEventListener("click", open);

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      const v = input.value.trim();
      if (!v) return;
      input.value = "";
      ask(v);
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && panel.classList.contains("is-on")) close();
    });

    // Teaser appears once per session, six seconds in, and stays dismissed.
    let dismissed = false;
    try { dismissed = sessionStorage.getItem("psfp-chat-teaser") === "off"; } catch (err) {}
    if (!dismissed) {
      setTimeout(function () {
        if (!panel.classList.contains("is-on")) teaser.classList.add("is-on");
      }, 6000);
    }

    // Warm the answers on first intent, so the first reply is not waiting on
    // a network round trip.
    launch.addEventListener("pointerenter", load, { once: true });
  })();
</script>
