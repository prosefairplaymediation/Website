---
/**
 * Shell for a /process article: header, prose body, closing CTA, and the
 * styling all five existing articles share.
 *
 * Written for pages produced by scripts/generate-article.mjs, so the
 * generator emits content and nothing else. The five hand-written articles
 * keep their own inline <style> blocks — they work, and rewriting five live
 * pages to prove a point about duplication is not worth the risk. If they
 * are ever touched for another reason, migrating them here is the tidy-up.
 *
 * Styles below are lifted from real-estate-mediation.astro so a generated
 * article is visually indistinguishable from a hand-written one.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleSchema from "./ArticleSchema.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import InlineScheduler from "./InlineScheduler.astro";

interface Props {
  slug: string;
  title: string;
  kicker: string;
  lede: string;
  description: string;
}
const { slug, title, kicker, lede, description } = Astro.props;
---

{/*
  The shared guides card, not a per-article one. The weekly workflow publishes
  without a human in the loop, so an article-specific card would mean every
  generated page shipped pointing at an image nobody had made.
*/}
<BaseLayout
  title={`${title} · Pro Se Fair Play Mediation`}
  description={description}
  ogImage="/og/guides.jpg"
>
  <ArticleSchema slug={slug} />

  <header class="article-header">
    <div class="container article-header-inner">
      {/*
        The five hand-written guides each carry this, so an article without it
        would be the odd one out in its own section. Here rather than in the
        page so every future generated article gets it too.
      */}
      <Breadcrumbs
        trail={[{ href: "/process", label: "The Mediation Process" }]}
        current={title}
        tone="light"
      />
      <p class="kicker reveal reveal-d1">
        <span class="kicker-dot" aria-hidden="true"></span>
        {kicker}
      </p>
      <h1 class="display article-title reveal reveal-d2">{title}</h1>
      <p class="lede reveal reveal-d3">{lede}</p>
    </div>
  </header>

  <section class="article-body">
    <div class="container-narrow article-prose">
      <slot />
    </div>
  </section>

  {/*
    The calendar itself, not a link to it. A reader who has just finished the
    article is at peak intent; sending them to another page to re-commit is
    where the conversion was being lost. Lazy-loaded, so a reader who bounces
    never pays for the script.
  */}
  <InlineScheduler source="article" />
</BaseLayout>

<style>
  .article-header {
    position: relative;
    padding-block: clamp(4rem, 6vw + 1rem, 6rem) clamp(2rem, 3vw, 3rem);
    background:
      radial-gradient(ellipse at 80% 20%, rgba(196, 154, 75, 0.08), transparent 55%),
      var(--color-cream);
    border-bottom: 1px solid var(--color-divider);
    overflow: hidden;
  }
  .article-header-inner { position: relative; max-width: 64rem; }
  .article-title {
    margin-top: 1rem;
    font-size: var(--step-5);
    line-height: 1.04;
    color: var(--color-navy);
    letter-spacing: -0.025em;
    max-width: 20ch;
    font-weight: 400;
    text-wrap: balance;
  }
  .article-header .lede {
    margin-top: 1.5rem;
    max-width: 62ch;
    color: var(--color-ink-soft);
  }

  .article-body {
    padding-block: var(--space-lg) var(--space-3xl);
    background: var(--color-cream);
  }
  /* :global() because the prose arrives through <slot/> and so carries no
     scope attribute of this component. */
  .article-prose {
    font-family: var(--font-body);
    font-size: var(--step-1);
    line-height: 1.7;
    color: var(--color-ink-soft);
  }
  .article-prose :global(p) { max-width: 64ch; }
  .article-prose :global(p + p),
  .article-prose :global(ul + p) { margin-top: 1.25rem; }
  .article-prose :global(h2) {
    margin-top: var(--space-xl);
    margin-bottom: 1rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--color-gold);
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.1;
    color: var(--color-navy);
    letter-spacing: -0.015em;
    font-weight: 400;
  }
  .article-prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .article-prose :global(h3) {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24;
    font-size: 1.3rem;
    line-height: 1.25;
    color: var(--color-navy);
    letter-spacing: -0.005em;
    font-weight: 500;
  }
  .article-prose :global(ul) {
    margin: 1rem 0 1.25rem;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    max-width: 64ch;
  }
  .article-prose :global(li) { line-height: 1.55; }
  .article-prose :global(strong) { color: var(--color-navy); font-weight: 600; }

  .article-cta {
    position: relative;
    padding-block: var(--space-lg);
    background: var(--color-cream-warm);
    border-top: 1px solid var(--color-divider);
  }
  .article-cta::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold) 40%, var(--color-gold) 60%, transparent);
    opacity: 0.7;
  }
  .article-cta-inner { display: flex; justify-content: center; flex-wrap: wrap; }
  .article-cta-btn {
    background: var(--color-navy);
    color: var(--color-cream);
    border-color: var(--color-navy);
  }
  .article-cta-btn:hover {
    background: var(--color-navy-deep);
    color: var(--color-cream);
    border-color: var(--color-gold);
  }

  @media (max-width: 600px) {
    .article-title { font-size: clamp(2.25rem, 1.8rem + 3vw, 3.5rem); }
  }
</style>
